<!doctype html>
<html lang="{{ request.locale.iso_code }}" class="template-{{ template.name }}{% if settings.card_title_two_lines %} card-titles-clamped{% endif %}">
  <head>
    {% # Charset, viewport, social, title, etc. %}
    {% render 'meta-tags' %}

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% # Inlined CSS variables from the theme settings %}
    {% render 'theme-styles-variables' %}
    {% render 'color-palette' %}

    {% comment %}
      Font preloading: fonts are served from the store's own domain, so no
      preconnect is needed. Preload the body font and the heading font (the
      hero heading is usually the largest paint); other variants load on demand.
    {% endcomment %}
    {%- liquid
      assign body_font_url = settings.type_body_font | font_url
      assign heading_font_url = settings.type_heading_font | font_url
    -%}
    {% unless settings.type_body_font.system? %}
      {{ body_font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}
    {% unless settings.type_heading_font.system? or heading_font_url == body_font_url %}
      {{ heading_font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'header.css' | asset_url | stylesheet_tag }}
    {{ 'footer.css' | asset_url | stylesheet_tag }}
    {{ 'sections.css' | asset_url | stylesheet_tag }}
    {%- if settings.animations_page_transition %}
      {{ 'page-transition.css' | asset_url | stylesheet_tag }}
    {%- endif %}

    {{ content_for_header }}
  </head>

  <body class="template-{{ template.name | handle }}">
    <a class="skip-to-content button" href="#MainContent">
      {{ 'accessibility.skip_to_content' | t }}
    </a>

    {% sections 'header-group' %}

    <main id="MainContent" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% if settings.cart_type == 'drawer' and template.name != 'cart' %}
      {% render 'cart-drawer' %}
    {% endif %}

    {% if settings.quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {% comment %} Offscreen and on-tap scripts load later; see snippets/lazy-script.liquid. {% endcomment %}
    <script src="{{ 'lazy-modules.js' | asset_url }}" type="module"></script>
    <script src="{{ 'quantity-selector.js' | asset_url }}" type="module"></script>

    {% if template.name == 'article' %}
      <script src="{{ 'article.js' | asset_url }}" type="module"></script>
    {% endif %}

    {% if settings.animations_reveal_on_scroll %}
      <script src="{{ 'reveal.js' | asset_url }}" type="module"></script>
    {% endif %}

    {% if settings.animations_smooth_scroll %}
      {% render 'lazy-script', src: 'smooth-scroll.js', on: 'idle' %}
    {% endif %}

    {% if settings.animations_button_bubble %}
      {% render 'lazy-script', src: 'button-bubble.js', on: 'idle' %}
    {% endif %}

    {% if settings.animations_page_transition %}
      {% render 'lazy-script', src: 'page-transition.js', on: 'idle' %}
    {% endif %}

    {% if settings.animations_text_roll %}
      {% render 'lazy-script', src: 'text-roll.js', on: 'idle' %}
    {% endif %}
  </body>
</html>
