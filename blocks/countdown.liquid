{% doc %}
  A countdown to a date and time in the store's time zone, for launches and
  sales: days, hours, minutes, and seconds, as large editorial numerals
  between thin rules, boxes, or a single line.
  assets/countdown.js ticks it every second; once the time has passed it
  shows the "After it ends" text, or hides the block when that is empty.

  The deadline goes to the browser as a Unix timestamp. Shopify's date
  filter reads a date string without an offset in the store's time zone,
  with the UTC offset in force on that date, so a deadline on the far side of
  a daylight-saving change still lands on the merchant's wall-clock time
  (the store's current offset would put it an hour off). The filter guesses
  at text that isn't a date (it would read "soon 12:00" as today at noon),
  so the date must come back as written; otherwise, or when the time can't
  be read, `data-end` isn't a number and countdown.js hides the block.
{% enddoc %}

{%- liquid
  assign end = ''
  assign end_date = block.settings.end_date | strip
  if end_date != blank
    assign time = block.settings.end_time | default: '00:00' | strip
    assign end_local = end_date | append: ' ' | append: time
    assign parsed_date = end_local | date: '%Y-%m-%d'
    if parsed_date == end_date
      assign end = end_local | date: '%s'
    endif
  endif
-%}

<countdown-timer
  class="countdown countdown--{{ block.settings.style }} countdown--{{ block.settings.alignment }}"
  data-end="{{ end | escape }}"
  {% if block.settings.end_date == blank %}
    hidden
  {% endif %}
  {{ block.shopify_attributes }}
>
  {% if block.settings.label != blank %}
    <p class="countdown__label">{{ block.settings.label | escape }}</p>
  {% endif %}
  <div class="countdown__units" role="timer" aria-live="off">
    <span class="countdown__unit"><span class="countdown__value" data-unit="days">00</span><span class="countdown__name">{{ 'content.countdown_days' | t }}</span></span>
    <span class="countdown__unit"><span class="countdown__value" data-unit="hours">00</span><span class="countdown__name">{{ 'content.countdown_hours' | t }}</span></span>
    <span class="countdown__unit"><span class="countdown__value" data-unit="minutes">00</span><span class="countdown__name">{{ 'content.countdown_minutes' | t }}</span></span>
    <span class="countdown__unit"><span class="countdown__value" data-unit="seconds">00</span><span class="countdown__name">{{ 'content.countdown_seconds' | t }}</span></span>
  </div>
  {% if block.settings.expired_text != blank %}
    <p class="countdown__expired" hidden>{{ block.settings.expired_text | escape }}</p>
  {% endif %}
</countdown-timer>

{% render 'lazy-script', src: 'countdown.js' %}

{% schema %}
{
  "name": "t:names.countdown",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "end_date",
      "label": "t:settings.end_date",
      "default": "2026-12-24",
      "info": "t:info.countdown_date"
    },
    {
      "type": "text",
      "id": "end_time",
      "label": "t:settings.end_time",
      "default": "23:59",
      "info": "t:info.countdown_time"
    },
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.countdown_label"
    },
    {
      "type": "text",
      "id": "expired_text",
      "label": "t:settings.countdown_expired",
      "info": "t:info.countdown_expired"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        { "value": "editorial", "label": "t:options.countdown_style.editorial" },
        { "value": "boxes", "label": "t:options.countdown_style.boxes" },
        { "value": "inline", "label": "t:options.countdown_style.inline" }
      ],
      "default": "editorial"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        { "value": "left", "label": "t:options.alignment.left" },
        { "value": "center", "label": "t:options.alignment.center" },
        { "value": "right", "label": "t:options.alignment.right" }
      ],
      "default": "left"
    }
  ],
  "presets": [
    {
      "name": "t:names.countdown",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
