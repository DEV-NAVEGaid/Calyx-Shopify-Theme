{% doc %}
  One expanding panel: a photo with a number. Closed, it shows its title
  turned on its side; open, it shows the eyebrow, title, text, and link.
{% enddoc %}

{%- liquid
  assign number = 0
  for panel in section.blocks
    assign number = number | plus: 1
    if panel.id == block.id
      break
    endif
  endfor
-%}

<div class="panel{% if number == 1 %} is-active{% endif %}" data-panel {{ block.shopify_attributes }}>
  <div class="panel__media">
    {% if block.settings.image != blank %}
      {{ block.settings.image | image_url: width: 2400 | image_tag: widths: '600, 1100, 1600, 2400', sizes: '(min-width: 990px) 80vw, 100vw', loading: 'lazy', alt: block.settings.image.alt }}
    {% else %}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <span class="panel__number">{% if number < 10 %}0{% endif %}{{ number }}</span>

  <button class="panel__toggle" type="button" data-panel-open>
    <span class="panel__vertical-title">{{ block.settings.heading | escape }}</span>
  </button>

  <div class="panel__content">
    {% if block.settings.eyebrow != blank %}
      <p class="panel__eyebrow">{{ block.settings.eyebrow | escape }}</p>
    {% endif %}
    <h3 class="panel__title">{{ block.settings.heading | escape }}</h3>
    {% if block.settings.text != blank %}
      <p class="panel__text">{{ block.settings.text | escape }}</p>
    {% endif %}
    {% if block.settings.link_label != blank %}
      <a class="panel__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
        {{- block.settings.link_label | escape -}}
        <span class="panel__link-icon">{% render 'icon', icon: 'arrow-right' %}</span>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.panel",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.panel_1",
      "info": "t:info.panel_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.panel_text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.shop_the_scent"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.panel"
    }
  ]
}
{% endschema %}
