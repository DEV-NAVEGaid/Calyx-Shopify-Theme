{% doc %}
  One slide of the hero split product panel: a product photo (or the
  product's own image), the product name in italics, a line about it, and
  a Buy now link. Only the first slide shows until assets/hero-split.js
  starts cycling.
{% enddoc %}

{%- liquid
  assign product = block.settings.product
  assign image = block.settings.image | default: product.featured_image
  assign title = product.title
  if title == blank
    assign title = 'content.product_title_placeholder' | t
  endif
  assign text = block.settings.text
  if text == blank and product != blank
    assign text = product.description | strip_html | truncatewords: 18
  endif

  assign first = false
  if section.blocks.first.id == block.id
    assign first = true
  endif
-%}

<div class="hero-product" data-hero-slide {% unless first %}hidden{% endunless %} {{ block.shopify_attributes }}>
  <div class="hero-product__media">
    {%- if image != blank -%}
      {{ image | image_url: width: 1200 | image_tag: widths: '600, 900, 1200', sizes: '(min-width: 990px) 50vw, 100vw', alt: '' }}
    {%- else -%}
      {% render 'placeholder', name: 'product-1' %}
    {%- endif -%}
  </div>
  <div class="hero-product__copy">
    <p class="heading-italic hero-product__title">{{ title | escape }}</p>
    {% if text != blank %}
      <p class="hero-product__text">{{ text | escape }}</p>
    {% endif %}
  </div>
  <a class="hero-product__buy" href="{{ product.url | default: routes.all_products_collection_url }}">
    {{- 'actions.buy_now' | t -}}
    <span class="hero-product__buy-icon">{% render 'icon', icon: 'arrow-right' %}</span>
  </a>
</div>

{% schema %}
{
  "name": "t:names.hero_product",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.hero_product_image"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:info.hero_product_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_product"
    }
  ]
}
{% endschema %}
