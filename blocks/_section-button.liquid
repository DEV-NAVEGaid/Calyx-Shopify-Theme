{% doc %}
  A button or arrow link in a section's copy. Without a link it goes to the
  section's link or product, or else to all products.
{% enddoc %}

{%- liquid
  assign link = block.settings.link | default: section.settings.link | default: section.settings.product.url | default: routes.all_products_collection_url
  case block.settings.style
    when 'dark'
      assign button_class = 'button-dark'
    when 'secondary'
      assign button_class = 'button-secondary'
    when 'light'
      assign button_class = 'button-light'
    when 'link'
      assign button_class = 'arrow-link'
    else
      assign button_class = 'button'
  endcase
-%}

{% if block.settings.label != blank %}
  <a class="{{ button_class }} section-button" href="{{ link }}" {{ block.shopify_attributes }}>
    {{- block.settings.label | escape -}}
    {%- if block.settings.style == 'link' %}
      {% render 'icon', icon: 'arrow-right' %}
    {%- endif -%}
  </a>
{% endif %}

{% schema %}
{
  "name": "t:names.section_button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.shop_now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        { "value": "primary", "label": "t:options.button_variant.primary" },
        { "value": "dark", "label": "t:options.button_variant.dark" },
        { "value": "secondary", "label": "t:options.button_variant.secondary" },
        { "value": "light", "label": "t:options.button_variant.light" },
        { "value": "link", "label": "t:options.button_variant.link" }
      ],
      "default": "primary"
    }
  ],
  "presets": [{ "name": "t:names.section_button" }]
}
{% endschema %}
