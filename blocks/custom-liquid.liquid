{% doc %}
  Renders merchant-provided Liquid, for app snippets and custom markup.
{% enddoc %}

<div class="custom-liquid" {{ block.shopify_attributes }}>
  {{ block.settings.custom_liquid }}
</div>

{% schema %}
{
  "name": "t:names.custom_liquid",
  "tag": null,
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.liquid",
      "info": "t:info.custom_liquid"
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
