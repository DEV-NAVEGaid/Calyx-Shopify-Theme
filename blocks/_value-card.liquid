{% doc %}
  One value: an icon in a soft circle, a title, and a short line, in a
  bordered card.
{% enddoc %}

<div class="value-card" {{ block.shopify_attributes }}>
  <span class="value-card__icon">{% render 'icon', icon: block.settings.icon %}</span>
  <h3 class="h4">{{ block.settings.title | escape }}</h3>
  {% if block.settings.text != blank %}
    <p class="value-card__text">{{ block.settings.text | escape }}</p>
  {% endif %}
  {% if block.settings.link != blank and block.settings.link_label != blank %}
    <a class="arrow-link value-card__link" href="{{ block.settings.link }}">
      {{- block.settings.link_label | escape -}}
      {% render 'icon', icon: 'arrow-right' %}
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:names.value_card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "leaf", "label": "t:options.icon.leaf" },
        { "value": "heart", "label": "t:options.icon.heart" },
        { "value": "sparkle", "label": "t:options.icon.sparkle" },
        { "value": "gift", "label": "t:options.icon.gift" },
        { "value": "truck", "label": "t:options.icon.truck" },
        { "value": "return", "label": "t:options.icon.return" },
        { "value": "lock", "label": "t:options.icon.lock" },
        { "value": "check", "label": "t:options.icon.check" },
        { "value": "star", "label": "t:options.icon.star" },
        { "value": "chat", "label": "t:options.icon.chat" },
        { "value": "mail", "label": "t:options.icon.mail" }
      ],
      "default": "leaf"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "t:text_defaults.value_1"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.value_1_text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.value_card"
    }
  ]
}
{% endschema %}
