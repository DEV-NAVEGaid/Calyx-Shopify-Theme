{% doc %}
  One card of the social arch: a bold title, the poster's handle, and a
  photo whose height depends on how far the card sits from the middle.
{% enddoc %}

{%- liquid
  if block.settings.link != blank
    assign tag = 'a'
  else
    assign tag = 'div'
  endif
-%}

<li class="social-card" data-arch-card {{ block.shopify_attributes }}>
  <{{ tag }}
    class="social-card__inner"
    {% if block.settings.link != blank %}
      href="{{ block.settings.link }}"
    {% endif %}
  >
    <span class="social-card__label">
      <span class="social-card__title">{{ block.settings.title | escape }}</span>
      <span class="social-card__handle">{{ block.settings.handle | escape }}</span>
    </span>
    <span class="social-card__media">
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 400 | image_tag: widths: '200, 300, 400', sizes: '150px', loading: 'lazy', alt: block.settings.image.alt }}
      {%- else -%}
        {% render 'placeholder', name: 'lifestyle-1' %}
      {%- endif -%}
    </span>
  </{{ tag }}>
</li>

{% schema %}
{
  "name": "t:names.social_card",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "Add a title"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:settings.handle",
      "default": "@yourcommunity"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.social_card"
    }
  ]
}
{% endschema %}
