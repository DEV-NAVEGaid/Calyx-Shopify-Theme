{% doc %}
  One written review: who wrote it, whether they bought it, when, the
  stars, a title, and the review.
{% enddoc %}

<article class="review" data-review {{ block.shopify_attributes }}>
  <div class="review__meta">
    <p class="review__author">
      <span>{{ block.settings.author | escape }}</span>
      {% if block.settings.verified %}
        <span class="review__verified">{{ 'content.verified_buyer' | t }}</span>
      {% endif %}
    </p>
    {% if block.settings.date != blank %}
      <p class="review__date">{{ block.settings.date | escape }}</p>
    {% endif %}
  </div>
  {% render 'rating-stars', rating: block.settings.rating, max: 5 %}
  {% if block.settings.title != blank %}
    <h3 class="h5 review__title">{{ block.settings.title | escape }}</h3>
  {% endif %}
  <p class="review__text">{{ block.settings.text | escape }}</p>
</article>

{% schema %}
{
  "name": "t:names.review",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "rating",
      "label": "t:settings.rating",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "default": "t:text_defaults.product_review_1"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.product_review_1_text"
    },
    {
      "type": "text",
      "id": "author",
      "label": "t:settings.author",
      "default": "Customer name"
    },
    {
      "type": "text",
      "id": "date",
      "label": "t:settings.date"
    },
    {
      "type": "checkbox",
      "id": "verified",
      "label": "t:settings.verified_buyer",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "t:names.review"
    }
  ]
}
{% endschema %}
