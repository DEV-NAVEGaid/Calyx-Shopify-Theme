{% doc %}
  For a sold-out variant: "Notify me when it's back" with a line of text
  and an email field. It sends the request through the store's contact
  form, naming the product and variant, so it lands in the store's inbox.
  Hidden while the selected variant is in stock (shown in the theme
  editor so it can be styled).
{% enddoc %}

{%- liquid
  assign product = closest.product
  assign variant = product.selected_or_first_available_variant
  assign form_id = 'BackInStock-' | append: block.id
-%}

{% if variant.available == false or request.design_mode %}
  <div class="back-in-stock" {{ block.shopify_attributes }}>
    <p class="back-in-stock__heading">
      {% render 'icon', icon: 'mail', image: block.settings.custom_icon %}
      <span>{{ block.settings.heading | escape }}</span>
    </p>

    {% form 'contact', id: form_id, class: 'back-in-stock__form' %}
      {% if form.posted_successfully? %}
        <p class="back-in-stock__text" role="status">{{ 'content.back_in_stock_thanks' | t }}</p>
      {% else %}
        {% if block.settings.text != blank %}
          <p class="back-in-stock__text">{{ block.settings.text | escape }}</p>
        {% endif %}
        <input type="hidden" name="contact[body]" value="{{ 'content.back_in_stock_request' | t: product: product.title, variant: variant.title }} ({{ variant.id }})">
        <div class="back-in-stock__row">
          <label class="visually-hidden" for="{{ form_id }}-email">{{ 'blocks.email_signup.label' | t }}</label>
          <input class="field__input" id="{{ form_id }}-email" type="email" name="contact[email]" autocomplete="email" placeholder="{{ 'content.your_email' | t }}" required>
          <button class="button-dark" type="submit">{{ 'actions.notify_me' | t }}</button>
        </div>
        {% if form.errors %}
          <p class="back-in-stock__error" role="alert">{{ form.errors.messages.email | default: form.errors.messages.base }}</p>
        {% endif %}
      {% endif %}
    {% endform %}
  </div>
{% endif %}

{% schema %}
{
  "name": "t:names.back_in_stock",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "custom_icon",
      "label": "t:settings.custom_icon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.back_in_stock_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.back_in_stock_text"
    }
  ],
  "presets": [
    {
      "name": "t:names.back_in_stock",
      "category": "t:categories.product"
    }
  ]
}
{% endschema %}
