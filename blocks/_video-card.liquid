{% doc %}
  One community video: a muted, looping clip (or a photo) with the
  creator's handle, a play / pause button, and an optional product link.
{% enddoc %}

{%- liquid
  assign video = block.settings.video
  assign product = block.settings.product
-%}

<div class="video-card" data-video-card {{ block.shopify_attributes }}>
  <div class="video-card__media">
    {%- if video != blank -%}
      {{ video | video_tag: muted: true, loop: true, playsinline: true, preload: 'metadata', image_size: '920x' }}
    {%- elsif block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 920 | image_tag: widths: '460, 690, 920', sizes: '(min-width: 990px) 460px, 80vw', loading: 'lazy' }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  {% if block.settings.handle != blank %}
    <p class="video-card__handle">{{ block.settings.handle | escape }}</p>
  {% endif %}

  {% if video != blank %}
    <button class="video-card__toggle" type="button" data-video-toggle aria-pressed="false" aria-label="{{ 'accessibility.play_video' | t }}">
      {% render 'icon', icon: 'play' %}
      {% render 'icon', icon: 'pause' %}
    </button>
  {% endif %}

  {% if product != blank %}
    <a class="video-card__product" href="{{ product.url }}">
      {%- if product.featured_image -%}
        {{ product.featured_image | image_url: width: 160 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag }}
      {%- endif -%}
      <span class="visually-hidden">{{ product.title | escape }}</span>
    </a>
  {% endif %}
</div>

{% schema %}
{
  "name": "t:names.video_card",
  "tag": null,
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.video_card_image"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:settings.handle",
      "default": "@yourcommunity"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    }
  ],
  "presets": [
    {
      "name": "t:names.video_card"
    }
  ]
}
{% endschema %}
