{% doc %}
  The cart page heading with the number of items beside it.
{% enddoc %}

<div class="cart-title" {{ block.shopify_attributes }}>
  <h1 class="{{ block.settings.type_preset }}">{{ 'content.cart_title' | t }}</h1>
  {%- if cart.item_count > 0 %}
    <span class="cart-title__count">{{ 'content.cart_item_count' | t: count: cart.item_count }}</span>
  {%- endif %}
</div>

{% schema %}
{
  "name": "t:names.cart_title",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "type_preset",
      "label": "t:settings.preset",
      "options": [
        {
          "value": "paragraph",
          "label": "t:options.type_preset.paragraph"
        },
        {
          "value": "h1",
          "label": "t:options.type_preset.h1"
        },
        {
          "value": "h2",
          "label": "t:options.type_preset.h2"
        },
        {
          "value": "h3",
          "label": "t:options.type_preset.h3"
        },
        {
          "value": "h4",
          "label": "t:options.type_preset.h4"
        },
        {
          "value": "h5",
          "label": "t:options.type_preset.h5"
        },
        {
          "value": "h6",
          "label": "t:options.type_preset.h6"
        }
      ],
      "default": "h2"
    }
  ]
}
{% endschema %}
