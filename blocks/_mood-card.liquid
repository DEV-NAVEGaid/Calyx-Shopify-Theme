{% doc %}
  A colored, numbered card in the mood grid. The number follows the card's
  position. The color comes from the card, or from the title's line in
  Theme settings > Swatches, or falls back to the soft accent color. With an
  image, the image fills the card under a dark gradient so the light text
  stays readable.
{% enddoc %}

{%- liquid
  assign number = 0
  for card in section.blocks
    assign number = number | plus: 1
    if card.id == block.id
      break
    endif
  endfor

  if block.settings.color != blank
    assign card_style = '--swatch-background: ' | append: block.settings.color | append: ';'
  else
    capture card_style
      render 'swatch-style', label: block.settings.title
    endcapture
  endif
-%}

{%- if block.settings.image != blank -%}
  {%- assign card_style = card_style | append: ' --mood-overlay: ' | append: block.settings.overlay_opacity | append: '%;' -%}
{%- endif -%}

<a class="mood-card{% if block.settings.image != blank %} mood-card--image{% endif %}" href="{{ block.settings.link | default: routes.all_products_collection_url }}" style="{{ card_style }}" {{ block.shopify_attributes }}>
  {%- if block.settings.image != blank -%}
    <span class="mood-card__media" aria-hidden="true">
      {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '400, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy', alt: '' }}
    </span>
  {%- endif -%}
  <span class="eyebrow mood-card__number">{% if number < 10 %}0{% endif %}{{ number }}</span>
  <span class="mood-card__body">
    <span class="h3 mood-card__title">{{ block.settings.title | escape }}</span>
    {% if block.settings.text != blank %}
      <span class="mood-card__text">{{ block.settings.text | escape }}</span>
    {% endif %}
    {% if block.settings.link_label != blank %}
      <span class="arrow-link">
        {{- block.settings.link_label | escape -}}
        {% render 'icon', icon: 'arrow-right' %}
      </span>
    {% endif %}
  </span>
</a>

{% schema %}
{
  "name": "t:names.mood_card",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.heading",
      "default": "Calm"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.mood_calm"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.shop_now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "color",
      "id": "color",
      "label": "t:settings.background_color",
      "info": "t:info.mood_card_color"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "t:settings.overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ block.settings.image != blank }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.mood_card"
    }
  ]
}
{% endschema %}
