{% doc %}
  A featured card in a mega menu: image, heading, and a link. The card
  shows in the menu item named in "Menu item"; assets/header.js moves it
  there.
{% enddoc %}

<div class="mega-promo" data-menu-item="{{ block.settings.menu_item | handle }}" {{ block.shopify_attributes }}>
  <a class="mega-promo__media" href="{{ block.settings.link | default: routes.all_products_collection_url }}" tabindex="-1" aria-hidden="true">
    {% if block.settings.image != blank %}
      {{ block.settings.image | image_url: width: 600 | image_tag: widths: '240, 360, 480, 600', sizes: '240px', loading: 'lazy', alt: '' }}
    {% else %}
      {% render 'placeholder', name: 'product-1' %}
    {% endif %}
  </a>
  <p class="mega-promo__heading">{{ block.settings.heading | escape }}</p>
  <a class="mega-promo__link" href="{{ block.settings.link | default: routes.all_products_collection_url }}">
    {{- block.settings.link_label | escape -}}
    {% render 'icon', icon: 'arrow-right' %}
  </a>
</div>

{% schema %}
{
  "name": "t:names.mega_menu_promo",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "menu_item",
      "label": "t:settings.menu_item",
      "default": "Shop",
      "info": "t:info.menu_item"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.mega_promo_heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.shop_now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.mega_menu_promo"
    }
  ]
}
{% endschema %}
