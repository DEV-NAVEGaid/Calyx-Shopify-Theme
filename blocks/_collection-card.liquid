{% doc %}
  A card for the closest collection, linked to the collection page.
{% enddoc %}

{%- liquid
  assign collection = closest.collection
  assign placeholder_title = 'content.collection_title_placeholder' | t

  case block.settings.image_ratio
    when 'square'
      assign ratio = '1 / 1'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'landscape'
      assign ratio = '16 / 9'
    else
      assign ratio = collection.featured_image.aspect_ratio | default: 1
  endcase
-%}

<a class="collection-card" href="{{ collection.url }}" style="--media-ratio: {{ ratio }};" {{ block.shopify_attributes }}>
  <div class="collection-card__media">
    {% if collection.featured_image %}
      {{
        collection.featured_image
        | image_url: width: 1200
        | image_tag: widths: '300, 600, 900, 1200', sizes: '(min-width: 990px) 33vw, 50vw', loading: 'lazy'
      }}
    {% else %}
      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
    {% endif %}
  </div>

  <p class="collection-card__title h5">
    {{- collection.title | default: placeholder_title -}}
    {%- if block.settings.show_product_count %} <span class="collection-card__count">({{ collection.products_count }})</span>{% endif -%}
  </p>

  {% if block.settings.show_description and collection.description != blank %}
    <p class="collection-card__description">{{ collection.description | strip_html | truncatewords: 15 }}</p>
  {% endif %}
</a>

{% schema %}
{
  "name": "t:names.collection_card",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.aspect_ratio.adapt"
        },
        {
          "value": "square",
          "label": "t:options.aspect_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.aspect_ratio.portrait"
        },
        {
          "value": "landscape",
          "label": "t:options.aspect_ratio.landscape"
        }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "t:settings.show_product_count",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:settings.show_description",
      "default": false
    }
  ]
}
{% endschema %}
