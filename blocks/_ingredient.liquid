{% doc %}
  One ingredient of the ingredients explorer: its numbered photo in the
  row of photos, plus templates for its name in the list and its
  description beside it. The section cannot read these settings, so
  assets/ingredients-explorer.js copies the templates into the list.
{% enddoc %}

{%- liquid
  assign number = 0
  for item in section.blocks
    assign number = number | plus: 1
    if item.id == block.id
      break
    endif
  endfor
  assign index = number | minus: 1
-%}

<div class="ingredients-explorer__ingredient" {{ block.shopify_attributes }}>
  <button
    class="ingredients-explorer__thumb"
    type="button"
    data-ingredient-select="{{ index }}"
    aria-pressed="{% if number == 1 %}true{% else %}false{% endif %}"
    aria-label="{{ block.settings.name | escape }}"
  >
    <span class="ingredients-explorer__index">[{{ number }}]</span>
    <span class="ingredients-explorer__photo">
      {%- if block.settings.image != blank -%}
        {{ block.settings.image | image_url: width: 260 | image_tag: loading: 'lazy', alt: '' }}
      {%- else -%}
        {% render 'placeholder', name: 'lifestyle-2' %}
      {%- endif -%}
    </span>
  </button>

  <template data-ingredient-item-template>
    <li>
      <button
        class="ingredients-explorer__item"
        type="button"
        data-ingredient-select="{{ index }}"
        aria-pressed="{% if number == 1 %}true{% else %}false{% endif %}"
      >
        <span class="ingredients-explorer__index">[{{ number }}]</span>
        <span class="h5">{{ block.settings.name | escape }}</span>
      </button>
    </li>
  </template>

  <template data-ingredient-description-template>
    <div class="ingredients-explorer__description" data-ingredient-description {% unless number == 1 %}hidden{% endunless %}>
      {{ block.settings.description }}
    </div>
  </template>
</div>

{% schema %}
{
  "name": "t:names.ingredient",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "name",
      "label": "t:settings.name",
      "default": "Ingredient"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description",
      "default": "t:html_defaults.ingredient_1"
    }
  ],
  "presets": [
    {
      "name": "t:names.ingredient"
    }
  ]
}
{% endschema %}
