{% doc %}
  Renders a link styled as a primary button, secondary button, or text link.
{% enddoc %}

{%- assign link = block.settings.link -%}

<a
  class="button-block {{ block.settings.style_class }} size-style"
  {% if link != blank %}
    href="{{ link }}"
  {% else %}
    role="link" aria-disabled="true"
  {% endif %}
  {% if block.settings.open_in_new_tab %}
    target="_blank" rel="noopener"
  {% endif %}
  style="{% render 'size-style', settings: block.settings %}"
  {{ block.shopify_attributes }}
>
  {{- block.settings.label | escape -}}
</a>

{% schema %}
{
  "name": "t:names.button",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.label",
      "default": "t:text_defaults.button_label"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "t:settings.open_in_new_tab",
      "default": false
    },
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.button_style.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.button_style.secondary"
        },
        {
          "value": "button-dark",
          "label": "t:options.button_style.dark"
        },
        {
          "value": "button-light",
          "label": "t:options.button_style.light"
        },
        {
          "value": "link",
          "label": "t:options.button_style.link"
        }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "fit",
          "label": "t:options.width.fit"
        },
        {
          "value": "fill",
          "label": "t:options.width.fill"
        },
        {
          "value": "custom",
          "label": "t:options.width.custom"
        }
      ],
      "default": "fit"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 5,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    }
  ],
  "presets": [
    {
      "name": "t:names.button",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
