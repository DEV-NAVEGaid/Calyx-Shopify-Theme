{% doc %}
  One promise along the bottom of the full hero: an icon in a small
  bordered square and a short line.
{% enddoc %}

<li class="hero-feature" {{ block.shopify_attributes }}>
  <span class="hero-feature__icon">{% render 'icon', icon: block.settings.icon %}</span>
  <span>{{ block.settings.text | escape }}</span>
</li>

{% schema %}
{
  "name": "t:names.hero_feature",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "leaf", "label": "t:options.icon.leaf" },
        { "value": "sparkle", "label": "t:options.icon.sparkle" },
        { "value": "heart", "label": "t:options.icon.heart" },
        { "value": "check", "label": "t:options.icon.check" },
        { "value": "truck", "label": "t:options.icon.truck" },
        { "value": "gift", "label": "t:options.icon.gift" },
        { "value": "star", "label": "t:options.icon.star" },
        { "value": "lock", "label": "t:options.icon.lock" }
      ],
      "default": "leaf"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.hero_feature_1"
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_feature"
    }
  ]
}
{% endschema %}
