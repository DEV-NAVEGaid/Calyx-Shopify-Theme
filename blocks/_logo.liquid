{% doc %}
  One logo in the logo list, optionally linked. Without an image it shows
  the name on a muted tile.
{% enddoc %}

{%- liquid
  if block.settings.link != blank
    assign tag = 'a'
  else
    assign tag = 'div'
  endif
-%}

<li class="logo-list__item" {{ block.shopify_attributes }}>
  <{{ tag }}
    class="logo-tile"
    {% if block.settings.link != blank %}
      href="{{ block.settings.link }}"
    {% endif %}
  >
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 480 | image_tag: widths: '240, 480', sizes: '240px', loading: 'lazy', alt: block.settings.name | default: block.settings.image.alt }}
    {%- else -%}
      <span class="eyebrow logo-tile__name">{{ block.settings.name | escape }}</span>
    {%- endif -%}
  </{{ tag }}>
</li>

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "name",
      "label": "t:settings.name",
      "default": "t:text_defaults.stockist_logo"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    }
  ],
  "presets": [
    {
      "name": "t:names.logo"
    }
  ]
}
{% endschema %}
