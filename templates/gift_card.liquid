{% layout none %}

<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    {% # Charset, viewport, social, title, etc. %}
    {% render 'meta-tags' %}

    {% if settings.favicon %}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {% endif %}

    {% # Inlined CSS variables from the theme settings %}
    {% render 'theme-styles-variables' %}
    {% render 'color-palette' %}

    {% unless settings.type_body_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>
      {{ settings.type_body_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ 'gift-card.css' | asset_url | stylesheet_tag }}

    <script src="{{ 'vendor/qrcode.js' | shopify_asset_url }}" defer></script>
    {{ content_for_header }}
  </head>

  <body class="template-gift-card">
    <main class="gift-card-page" id="MainContent">
      <p class="gift-card-page__wordmark">{{ shop.name }}</p>

      {%- capture amount -%}{% render 'format-money', amount: gift_card.balance %}{%- endcapture -%}
      <h1 class="gift-card-page__heading">
        {{ 'gift_card.heading' | t: value: amount }}
      </h1>

      {% if gift_card.enabled == false or gift_card.expired %}
        <p class="gift-card-page__notice" role="status">{{ 'gift_card.expired' | t }}</p>
      {% else %}
        <p class="gift-card-page__intro">{{ 'gift_card.intro' | t }}</p>
      {% endif %}

      <div class="gift-card-visual">
        {% if settings.gift_card_image %}
          {{
            settings.gift_card_image
            | image_url: width: 960
            | image_tag: alt: '', class: 'gift-card-visual__image', loading: 'eager', width: 480, height: 300
          }}
        {% endif %}

        <div class="gift-card-visual__content">
          <p class="gift-card-visual__wordmark">{{ shop.name }}</p>
          <p class="gift-card-visual__eyebrow">{{ 'gift_card.eyebrow' | t }}</p>
          <p class="gift-card-visual__balance">{{ amount }}</p>
        </div>
      </div>

      <div class="gift-card-code">
        <span class="gift-card-code__value" data-gift-card-code>{{ gift_card.code | format_code }}</span>
        <button
          class="gift-card-code__copy"
          type="button"
          data-gift-card-copy
          data-copy-label="{{ 'gift_card.copy_code' | t }}"
          data-copied-label="{{ 'gift_card.code_copied' | t }}"
        >
          {{ 'gift_card.copy_code' | t }}
        </button>
      </div>

      <p class="gift-card-page__balance">
        {%- if gift_card.expires_on -%}
          {%- assign expires_on = gift_card.expires_on | date: format: 'date' -%}
          {{ 'gift_card.balance_expiry' | t: balance: amount, expires_on: expires_on }}
        {%- else -%}
          {{ 'gift_card.balance_no_expiry' | t: balance: amount }}
        {%- endif -%}
      </p>

      <div class="gift-card-qr" id="GiftCardQr" data-gift-card-qr="{{ gift_card.qr_identifier }}"></div>
      <p class="gift-card-page__caption">{{ 'gift_card.qr_caption' | t }}</p>

      <div class="gift-card-actions">
        <a class="button button-dark gift-card-actions__item" href="{{ routes.root_url }}">
          {{ 'gift_card.start_shopping' | t }}
        </a>

        {% if gift_card.pass_url %}
          <a class="button-secondary gift-card-actions__item" href="{{ gift_card.pass_url }}">
            {{ 'gift_card.add_to_apple_wallet' | t }}
          </a>
        {% endif %}

        <button class="button-secondary gift-card-actions__item" type="button" data-gift-card-print>
          {{ 'gift_card.print' | t }}
        </button>
      </div>
    </main>

    <script src="{{ 'gift-card.js' | asset_url }}" type="module"></script>
  </body>
</html>
