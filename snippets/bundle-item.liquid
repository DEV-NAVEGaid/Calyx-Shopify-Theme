{% doc %}
  One tickable product card in the product bundle. While ticked, its
  variant id and quantity go into the bundle form as `items[index]`.

  @param {product} item - The product.
  @param {variant} variant - The variant to add.
  @param {number} index - Position in the bundle, for the field names.

  @example
  {% render 'bundle-item', item: product, variant: variant, index: 0 %}
{% enddoc %}

{%- liquid
  assign compare = variant.compare_at_price | default: variant.price | at_least: variant.price
  assign input_id = 'bundle-' | append: section.id | append: '-' | append: index
-%}

<label class="bundle-item" for="{{ input_id }}" data-bundle-item data-price="{{ variant.price }}" data-compare="{{ compare }}">
  <span class="bundle-item__media">
    {%- if item.featured_image -%}
      {{ item.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
    {%- else -%}
      {% render 'placeholder', name: 'product-1' %}
    {%- endif -%}
  </span>
  <span class="bundle-item__text">
    <span class="bundle-item__title">{{ item.title | escape }}</span>
    <span class="bundle-item__price">{% render 'format-money', amount: variant.price %}</span>
  </span>
  <input class="bundle-item__check" type="checkbox" id="{{ input_id }}" checked data-bundle-check>
  <span class="bundle-item__box" aria-hidden="true">{% render 'icon', icon: 'check' %}</span>
  <input type="hidden" name="items[{{ index }}][id]" value="{{ variant.id }}" data-bundle-field>
  <input type="hidden" name="items[{{ index }}][quantity]" value="1" data-bundle-field>
</label>
