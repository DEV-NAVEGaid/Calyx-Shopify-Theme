{% doc %}
  Progress toward free shipping (Theme settings > Cart): a bar and how much
  is left, or that it is unlocked. Renders nothing when the bar is turned
  off, the cart is empty, or the cart is in another currency.

  @param {boolean} [icon] - Show a truck icon before the message.

  @example
  {% render 'free-shipping-bar', icon: true %}
{% enddoc %}

{%- liquid
  assign threshold = settings.free_shipping_threshold | times: 100
-%}

{% if settings.show_free_shipping_bar and threshold > 0 and cart.item_count > 0 and cart.currency.iso_code == shop.currency %}
  {%- liquid
    assign remaining = threshold | minus: cart.total_price
    capture remaining_amount
      render 'format-money', amount: remaining
    endcapture
    assign progress = cart.total_price | times: 100 | divided_by: threshold | at_most: 100
  -%}
  <div class="free-shipping">
    <p class="free-shipping__message">
      {%- if icon -%}{% render 'icon', icon: 'truck', class: 'free-shipping__icon' %}{%- endif -%}
      <span>
        {%- if remaining > 0 -%}
          {{ 'content.free_shipping_remaining_html' | t: amount: remaining_amount }}
        {%- else -%}
          {{ 'content.free_shipping_unlocked_html' | t }}
        {%- endif -%}
      </span>
    </p>
    <div class="free-shipping__track" aria-hidden="true">
      <div class="free-shipping__fill" style="--progress: {{ progress }}%;"></div>
    </div>
  </div>
{% endif %}
