{% doc %}
  Outputs the custom Typography settings of a block as CSS custom
  properties. Only used when `type_preset` is `custom`; the other presets
  are styled by the `.paragraph` and `.h1`–`.h6` classes.

  @param {object} settings - Settings with `type_preset`, `font`,
    `font_size`, `line_height`, `letter_spacing`, and `case`.

  @example
  <div class="text-block text-block--{{ block.settings.type_preset }}" style="{% render 'typography-style', settings: block.settings %}">
{% enddoc %}

{%- if settings.type_preset == 'custom' -%}
  --font-family: var(--font-{{ settings.font }}--family); --font-style: var(--font-{{ settings.font }}--style); --font-weight: var(--font-{{ settings.font }}--weight); --font-size: {{ settings.font_size }}px; --line-height: {{ settings.line_height }}; --letter-spacing: {{ settings.letter_spacing }}; --text-transform: {{ settings.case }};
{%- endif -%}
