  {
    "name": "t:names.logo_and_favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "t:settings.logo"
      },
      {
        "type": "range",
        "id": "logo_height",
        "label": "t:settings.desktop_height",
        "min": 12,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 30,
        "visible_if": "{{ settings.logo != blank }}"
      },
      {
        "type": "range",
        "id": "logo_height_mobile",
        "label": "t:settings.mobile_height",
        "min": 12,
        "max": 100,
        "step": 1,
        "unit": "px",
        "default": 24,
        "visible_if": "{{ settings.logo != blank }}"
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "t:settings.favicon",
        "info": "t:info.favicon"
      }
    ]
  },
