{% comment %}
  The blog page: a centred journal header with category filters, the newest
  article featured, then a paginated grid of the remaining articles.
{% endcomment %}

<div
  class="section section--page-width spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.background_color != blank %}--section-background: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.text_color != blank %}--section-text-color: {{ section.settings.text_color }};{% endif %}
  "
>
  <div class="section-content main-blog">
    <header class="journal-header">
      <p class="journal-header__eyebrow">{{ blog.title }}</p>
      <h1 class="journal-header__title">{{ section.settings.heading }}</h1>
      {% if section.settings.description != blank %}
        <div class="journal-header__description rte">{{ section.settings.description }}</div>
      {% endif %}

      {% if section.settings.show_tags and blog.all_tags.size > 0 %}
        <nav class="journal-tabs" aria-label="{{ 'content.categories' | t }}">
          <a
            class="journal-tab"
            href="{{ blog.url }}"
            {% unless current_tags %}
              aria-current="page"
            {% endunless %}
          >
            {{- 'content.all_stories' | t -}}
          </a>
          {% for tag in blog.all_tags %}
            <a
              class="journal-tab"
              href="{{ blog.url }}/tagged/{{ tag | handle }}"
              {% if current_tags contains tag %}
                aria-current="page"
              {% endif %}
            >
              {{- tag -}}
            </a>
          {% endfor %}
        </nav>
      {% endif %}
    </header>

    {% paginate blog.articles by section.settings.articles_per_page %}
      {%- liquid
        assign featured = nil
        if paginate.current_page == 1 and current_tags == blank
          assign featured = blog.articles.first
        endif
        assign featured_words = featured.content | strip_html | split: ' ' | size
        assign featured_read_time = featured_words | divided_by: 200 | at_least: 1
      -%}

      {% if featured %}
        <article class="journal-featured">
          {% if featured.image %}
            <a class="journal-featured__media" href="{{ featured.url }}" tabindex="-1" aria-hidden="true">
              {{
                featured.image
                | image_url: width: 1440
                | image_tag: widths: '480, 720, 1080, 1440', sizes: '(min-width: 990px) 50vw, 100vw'
              }}
            </a>
          {% endif %}

          <div class="journal-featured__content">
            <p class="journal-featured__meta">
              {%- if featured.tags.size > 0 -%}
                <span class="badge badge--tag">{{ featured.tags.first }}</span>
              {%- endif -%}
              <span>{{ 'content.min_read' | t: count: featured_read_time }}</span>
            </p>

            <h2 class="journal-featured__title h2">
              <a href="{{ featured.url }}">{{ featured.title | escape }}</a>
            </h2>

            <p class="journal-featured__excerpt">
              {{- featured.excerpt_or_content | strip_html | truncatewords: 32 -}}
            </p>

            <p class="journal-featured__author">
              <span class="article-header__avatar" aria-hidden="true">
                {%- if featured.user.image -%}
                  {{ featured.user.image | image_url: width: 80 | image_tag: widths: '40, 80', sizes: '40px', loading: 'lazy' }}
                {%- else -%}
                  {{ featured.author | slice: 0 }}
                {%- endif -%}
              </span>
              <span>
                {{ 'content.by_author' | t: author: featured.author }}
                <br>
                {{ featured.published_at | time_tag: format: 'date' }}
              </span>
            </p>

            <a class="journal-featured__link" href="{{ featured.url }}">
              {{ 'content.read_story' | t }}
              {% render 'icon', icon: 'arrow-right' %}
            </a>
          </div>
        </article>
      {% endif %}

      <ul
        class="product-grid journal-grid"
        role="list"
        style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};"
      >
        {% for article in blog.articles %}
          {% if article.id != featured.id %}
            <li>
              {% content_for 'block', type: '_blog-post-card', id: 'blog-post-card', closest.article: article %}
            </li>
          {% endif %}
        {% endfor %}
      </ul>

      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.blog",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Stories on scent, mood and ritual"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "t:settings.description",
      "default": "<p>Guides, ingredient deep-dives and the people behind our scents.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:settings.show_tags",
      "default": true
    },
    {
      "type": "range",
      "id": "articles_per_page",
      "label": "t:settings.articles_per_page",
      "min": 3,
      "max": 24,
      "step": 3,
      "default": 9
    },
    {
      "type": "header",
      "content": "t:content.grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 1,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        {
          "value": "1",
          "label": "t:options.columns.one"
        },
        {
          "value": "2",
          "label": "t:options.columns.two"
        }
      ],
      "default": "1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
