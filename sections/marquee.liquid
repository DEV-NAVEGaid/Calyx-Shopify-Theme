{% comment %}
  A strip of short phrases that scrolls on a loop, separated by sparkles.
  The phrases are blocks; the list is repeated so the loop has no gap.
  Pauses on hover and stays still for reduced motion.
{% endcomment %}

{%- capture items -%}
  {% content_for 'blocks' %}
{%- endcapture -%}

<div
  class="marquee spacing-style"
  style="{% render 'spacing-style', settings: section.settings %} --marquee-background: {{ section.settings.background_color }}; --marquee-text: {{ section.settings.text_color }}; --marquee-duration: {{ section.settings.speed }}s;"
>
  {% for copy in (1..2) %}
    <div class="marquee__track" {% if forloop.last %}aria-hidden="true"{% endif %}>
      {{ items }}
    </div>
  {% endfor %}
</div>

