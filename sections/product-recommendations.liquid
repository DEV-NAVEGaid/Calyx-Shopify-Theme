{% comment %}
  You may also like: a heading with a link, then products related to this
  one (or, on the cart page, to the first product in the cart) as cards.
  Shopify picks the products; the section first renders empty and
  assets/product-recommendations.js loads it from the product
  recommendations route. Each card is the static product card block.
{% endcomment %}

{%- assign source_id = product.id | default: cart.items.first.product_id -%}

{% if source_id != blank %}
  <product-recommendations
    class="home-section product-recommendations spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
    data-url="{{ routes.product_recommendations_url }}?product_id={{ source_id }}&limit={{ section.settings.max_products }}&section_id={{ section.id }}&intent=related"
  >
    {% if recommendations.performed? and recommendations.products_count > 0 %}
      <div class="home-section__inner">
        <div class="product-recommendations__header">
          {% if section.settings.heading != blank %}
            <h2 class="h3">{{ section.settings.heading | escape }}</h2>
          {% endif %}
          {% if section.settings.link_label != blank %}
            <a class="arrow-link" href="{{ section.settings.link | default: routes.all_products_collection_url }}">
              {{- section.settings.link_label | escape -}}
              {% render 'icon', icon: 'arrow-right' %}
            </a>
          {% endif %}
        </div>
        <ul class="product-recommendations__grid" role="list">
          {% for recommendation in recommendations.products %}
            <li>{% content_for 'block', type: 'product-card', id: 'product-card', closest.product: recommendation %}</li>
          {% endfor %}
        </ul>
      </div>
    {% endif %}
  </product-recommendations>
{% endif %}

{% render 'lazy-script', src: 'product-recommendations.js' %}

{% schema %}
{
  "name": "t:names.product_recommendations",
  "tag": "section",
  "class": "section-wrapper",
  "enabled_on": {
    "templates": ["product", "cart"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.related_heading"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.related_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "t:settings.max_products",
      "min": 2,
      "max": 8,
      "step": 1,
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.product_recommendations",
      "category": "t:categories.product",
      "blocks": {
        "product-card": {
          "type": "product-card",
          "static": true,
          "blocks": {
            "gallery": { "type": "_product-card-gallery", "settings": { "image_ratio": "portrait" } },
            "row": {
              "type": "group",
              "settings": { "content_direction": "row", "vertical_on_mobile": false, "horizontal_alignment": "space-between", "vertical_alignment": "flex-start", "width": "fill", "gap": 12 },
              "blocks": {
                "title": { "type": "product-title", "settings": { "type_preset": "paragraph", "heading_level": "h3" } },
                "price": { "type": "price", "settings": { "type_preset": "paragraph" } }
              },
              "block_order": ["title", "price"]
            }
          },
          "block_order": ["gallery", "row"]
        }
      }
    }
  ]
}
{% endschema %}
