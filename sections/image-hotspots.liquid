{% comment %}
  Image hotspots ("shop the look"): an optional eyebrow, heading, and text
  (static blocks) over a large image with dots placed on it. Each dot is a
  hotspot block that opens a product card, or a card of its own text.
  assets/image-hotspots.js opens one card at a time.
{% endcomment %}

<image-hotspots class="home-section image-hotspots spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner image-hotspots__inner">
    <div class="image-hotspots__intro section-copy{% if section.settings.center_copy %} section-copy--center{% endif %}">
      {% content_for 'block', type: '_section-eyebrow', id: 'eyebrow' %}
      {% content_for 'block', type: '_section-heading', id: 'heading' %}
      {% content_for 'block', type: '_section-text', id: 'text' %}
    </div>

    <div class="image-hotspots__media">
      {% if section.settings.image != blank %}
        {{
          section.settings.image
          | image_url: width: 2400
          | image_tag: widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'lazy', class: 'image-hotspots__image'
        }}
      {% else %}
        {% render 'placeholder', name: 'lifestyle-2', class: 'image-hotspots__image' %}
      {% endif %}
      {% content_for 'blocks' %}
    </div>
  </div>
</image-hotspots>

{% render 'lazy-script', src: 'image-hotspots.js' %}

