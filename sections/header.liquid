{% comment %}
  The store header. Large screens: menu on the left, logo in the middle,
  country/language, search, account, and cart on the right. Small screens:
  menu and search icons, logo, account and bag icons. The menu and logo are
  static blocks; mega menu promos are blocks that assets/header.js places in
  the matching mega menu.

  Sticky: off, always, or only while scrolling up (assets/header.js hides it
  on the way down). Background: a solid color, a gradient, or transparent
  over the first section (on the home page only, or everywhere). A
  transparent header can adapt its text to what is behind it: white text
  blended with mix-blend-mode: difference turns dark over light areas and
  light over dark ones, so it stays readable over photos and colored
  sections.

  Account is Shopify's <shopify-account> component: it opens a sheet to sign
  in and reach orders and profile without leaving the store. Signed out it
  shows "Account" (an icon on small screens); signed in, the customer's
  initial. For signed-out visitors it starts as a plain link to the account
  page and assets/header.js swaps the component in on their first
  interaction, so its sign-in iframe and scripts stay out of the page load.
{% endcomment %}

{%- liquid
  assign transparent = false
  if section.settings.background_style == 'transparent'
    if section.settings.transparent_home_only == false or request.page_type == 'index'
      assign transparent = true
    endif
  endif

  assign header_classes = 'header'
  case section.settings.sticky_mode
    when 'always'
      assign header_classes = header_classes | append: ' header--sticky'
    when 'scroll_up'
      assign header_classes = header_classes | append: ' header--sticky header--sticky-up'
  endcase
  if section.settings.border_bottom
    assign header_classes = header_classes | append: ' header--border'
  endif
  if transparent
    assign header_classes = header_classes | append: ' header--transparent'
    if section.settings.adaptive_text
      assign header_classes = header_classes | append: ' header--adaptive'
    endif
  elsif section.settings.background_style == 'gradient' and section.settings.background_gradient != blank
    assign header_classes = header_classes | append: ' header--gradient'
  endif

  assign cart_trigger = false
  if settings.cart_type == 'drawer' and request.page_type != 'cart'
    assign cart_trigger = true
  endif
-%}

<header-component
  class="{{ header_classes }}"
  style="
    {%- if section.settings.background_color != blank -%}--header-background: {{ section.settings.background_color }};{%- endif -%}
    {%- if section.settings.background_gradient != blank -%}--header-gradient: {{ section.settings.background_gradient }};{%- endif -%}
    {%- if section.settings.text_color != blank -%}--header-text: {{ section.settings.text_color }};{%- endif -%}
  "
>
  <div class="header__inner">
    <div class="header__start">
      {% content_for 'block', type: '_header-menu', id: 'header-menu' %}

      <a class="header__icon header__mobile-only" href="{{ routes.search_url }}" {% if settings.predictive_search_enabled %}data-search-open{% endif %}>
        {% render 'icon', icon: 'search' %}
        <span class="visually-hidden">{{ 'accessibility.search' | t }}</span>
      </a>
    </div>

    {% content_for 'block', type: '_header-logo', id: 'header-logo' %}

    <div class="header__end">
      {% if section.settings.show_localization %}
        <div class="header__desktop-only">
          {% render 'localization-form', id: 'HeaderLocalization', style: 'compact' %}
        </div>
      {% endif %}

      <a class="header__text-link header__desktop-only" href="{{ routes.search_url }}" {% if settings.predictive_search_enabled %}data-search-open{% endif %}>
        {{- 'content.search' | t -}}
      </a>

      {% if shop.customer_accounts_enabled %}
        {%- liquid
          # Pass a menu only when the store has it; otherwise the component shows its default links.
          assign account_menu = section.settings.customer_account_menu.handle
          if account_menu == blank and linklists['customer-account-main-menu'].links.size > 0
            assign account_menu = 'customer-account-main-menu'
          endif
        -%}
        {% if customer %}
          <shopify-account class="header__account" {% if account_menu != blank %}menu="{{ account_menu }}"{% endif %}>
            <span class="header__account-avatar" slot="signed-out-avatar">
              <span class="header__text-link header__desktop-only">{{ 'content.account' | t }}</span>
              <span class="header__icon header__mobile-only">
                {% render 'icon', icon: 'account' %}
                <span class="visually-hidden">{{ 'content.account' | t }}</span>
              </span>
            </span>
          </shopify-account>
        {% else %}
          <a class="header__account" href="{{ routes.account_url }}" data-account-link>
            <span class="header__account-avatar">
              <span class="header__text-link header__desktop-only">{{ 'content.account' | t }}</span>
              <span class="header__icon header__mobile-only">
                {% render 'icon', icon: 'account' %}
                <span class="visually-hidden">{{ 'content.account' | t }}</span>
              </span>
            </span>
          </a>
          <template data-account-template>
            <shopify-account class="header__account" {% if account_menu != blank %}menu="{{ account_menu }}"{% endif %}>
              <span class="header__account-avatar" slot="signed-out-avatar">
                <span class="header__text-link header__desktop-only">{{ 'content.account' | t }}</span>
                <span class="header__icon header__mobile-only">
                  {% render 'icon', icon: 'account' %}
                  <span class="visually-hidden">{{ 'content.account' | t }}</span>
                </span>
              </span>
            </shopify-account>
          </template>
        {% endif %}
      {% endif %}

      <a
        class="header__cart"
        href="{{ routes.cart_url }}"
        {% if cart_trigger %}
          data-cart-drawer-trigger
        {% endif %}
      >
        <span class="header__text-link header__desktop-only">
          {{- 'content.cart_title' | t -}}
          <span class="header__cart-count-text" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </span>
        <span class="header__icon header__mobile-only">
          {% render 'icon', icon: 'bag' %}
          <span class="header__cart-bubble" data-cart-count {% if cart.item_count == 0 %}hidden{% endif %}>
            {{- cart.item_count -}}
          </span>
        </span>
        <span class="visually-hidden">{{ 'accessibility.cart_count' | t: count: cart.item_count }}</span>
      </a>
    </div>
  </div>

  {% comment %} Mega menu promos wait here until assets/header.js moves them into their menu. {% endcomment %}
  <div class="header__promos" hidden>
    {% content_for 'blocks' %}
  </div>
</header-component>

{% if settings.predictive_search_enabled %}
  {% render 'search-modal' %}
{% endif %}

<script src="{{ 'header.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:names.header",
  "class": "header-section",
  "tag": "header",
  "enabled_on": {
    "groups": ["header"]
  },
  "blocks": [{ "type": "_mega-menu-promo" }],
  "settings": [
    {
      "type": "select",
      "id": "sticky_mode",
      "label": "t:settings.sticky_header",
      "options": [
        { "value": "none", "label": "t:options.sticky_mode.none" },
        { "value": "always", "label": "t:options.sticky_mode.always" },
        { "value": "scroll_up", "label": "t:options.sticky_mode.scroll_up" }
      ],
      "default": "always"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "background_style",
      "label": "t:settings.background",
      "options": [
        { "value": "solid", "label": "t:options.header_background.solid" },
        { "value": "gradient", "label": "t:options.header_background.gradient" },
        { "value": "transparent", "label": "t:options.header_background.transparent" }
      ],
      "default": "solid"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "info": "t:info.header_background_color",
      "visible_if": "{{ section.settings.background_style == 'solid' }}"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "t:settings.gradient",
      "default": "linear-gradient(90deg, rgba(247, 243, 236, 1) 0%, rgba(231, 226, 248, 1) 100%)",
      "visible_if": "{{ section.settings.background_style == 'gradient' }}"
    },
    {
      "type": "checkbox",
      "id": "transparent_home_only",
      "label": "t:settings.transparent_home_only",
      "default": true,
      "info": "t:info.transparent_home_only",
      "visible_if": "{{ section.settings.background_style == 'transparent' }}"
    },
    {
      "type": "checkbox",
      "id": "adaptive_text",
      "label": "t:settings.adaptive_text",
      "default": true,
      "info": "t:info.adaptive_text",
      "visible_if": "{{ section.settings.background_style == 'transparent' }}"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color",
      "info": "t:info.header_text_color"
    },
    {
      "type": "checkbox",
      "id": "border_bottom",
      "label": "t:settings.border_bottom",
      "default": true
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "checkbox",
      "id": "show_localization",
      "label": "t:settings.show_localization",
      "default": true,
      "info": "t:info.show_localization"
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "t:settings.customer_account_menu",
      "info": "t:info.customer_account_menu"
    }
  ]
}
{% endschema %}
