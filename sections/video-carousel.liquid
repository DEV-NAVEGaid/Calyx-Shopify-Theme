{% comment %}
  Community videos: a heading column with arrows and a counter, beside a
  row of tall video cards (blocks) that scrolls one card at a time and
  runs off the right edge of the page.
{% endcomment %}

<video-carousel class="home-section video-carousel spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="video-carousel__intro">
    <div class="video-carousel__heading">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="video-carousel__title">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>

    <div class="video-carousel__footer">
      {% if section.settings.text != blank %}
        <div class="video-carousel__text body-l">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.blocks.size > 1 %}
        <div class="video-carousel__controls">
          <button
            class="round-arrow round-arrow--square video-carousel__previous"
            type="button"
            data-scroll-step="-1"
            aria-label="{{ 'accessibility.previous_slide' | t }}"
            disabled
          >
            {% render 'icon', icon: 'arrow-right' %}
          </button>
          <button
            class="round-arrow round-arrow--square"
            type="button"
            data-scroll-step="1"
            aria-label="{{ 'accessibility.next_slide' | t }}"
          >
            {% render 'icon', icon: 'arrow-right' %}
          </button>
          <span class="video-carousel__count" aria-hidden="true">
            <span data-carousel-current>1</span> / {{ section.blocks.size }}
          </span>
        </div>
      {% endif %}
    </div>
  </div>

  <div class="video-carousel__track" data-scroller>
    {% content_for 'blocks' %}
  </div>
</video-carousel>

{% render 'lazy-script', src: 'video-carousel.js' %}

{% schema %}
