{% comment %}
  Value cards: a centered heading over a row of bordered cards (blocks),
  each an icon in a soft circle, a title, and a short line.
{% endcomment %}

<div class="home-section value-cards spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="{{ section.settings.heading_size }} value-cards__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="value-cards__grid{% if section.settings.icon_style == 'plain' %} value-cards--plain{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.value_cards",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_value-card" }],
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.values_heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        { "value": "h2", "label": "t:options.type_preset.h2" },
        { "value": "h3", "label": "t:options.type_preset.h3" }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "t:settings.icon_style",
      "options": [
        { "value": "circle", "label": "t:options.icon_style.circle" },
        { "value": "plain", "label": "t:options.icon_style.plain" }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.value_cards",
      "category": "t:categories.text",
      "blocks": {
        "value_1": { "type": "_value-card", "settings": { "icon": "leaf", "title": "t:text_defaults.value_1", "text": "t:text_defaults.value_1_text" } },
        "value_2": { "type": "_value-card", "settings": { "icon": "heart", "title": "t:text_defaults.value_2", "text": "t:text_defaults.value_2_text" } },
        "value_3": { "type": "_value-card", "settings": { "icon": "sparkle", "title": "t:text_defaults.value_3", "text": "t:text_defaults.value_3_text" } }
      },
      "block_order": ["value_1", "value_2", "value_3"]
    }
  ]
}
{% endschema %}
