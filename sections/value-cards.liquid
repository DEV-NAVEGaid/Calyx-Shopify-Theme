{% comment %}
  Value cards: a centered heading over a row of bordered cards (blocks),
  each an icon in a soft circle, a title, and a short line.
{% endcomment %}

<div class="home-section value-cards spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="{{ section.settings.heading_size }} value-cards__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <div class="value-cards__grid{% if section.settings.icon_style == 'plain' %} value-cards--plain{% endif %}">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.value_cards",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_value-card"
    }
  ],
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.values_heading"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "t:settings.heading_size",
      "options": [
        {
          "value": "h2",
          "label": "t:options.type_preset.h2"
        },
        {
          "value": "h3",
          "label": "t:options.type_preset.h3"
        }
      ],
      "default": "h3"
    },
    {
      "type": "select",
      "id": "icon_style",
      "label": "t:settings.icon_style",
      "options": [
        {
          "value": "circle",
          "label": "t:options.icon_style.circle"
        },
        {
          "value": "plain",
          "label": "t:options.icon_style.plain"
        }
      ],
      "default": "circle"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "t:settings.eyebrow_font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "normal",
          "label": "t:options.layout_width.normal"
        },
        {
          "value": "wide",
          "label": "t:options.layout_width.wide"
        }
      ],
      "default": "normal",
      "info": "t:info.layout_width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.value_cards",
      "category": "t:categories.text",
      "blocks": {
        "value_1": {
          "type": "_value-card",
          "settings": {
            "icon": "leaf",
            "title": "t:text_defaults.value_1",
            "text": "t:text_defaults.value_1_text"
          }
        },
        "value_2": {
          "type": "_value-card",
          "settings": {
            "icon": "heart",
            "title": "t:text_defaults.value_2",
            "text": "t:text_defaults.value_2_text"
          }
        },
        "value_3": {
          "type": "_value-card",
          "settings": {
            "icon": "sparkle",
            "title": "t:text_defaults.value_3",
            "text": "t:text_defaults.value_3_text"
          }
        }
      },
      "block_order": [
        "value_1",
        "value_2",
        "value_3"
      ]
    }
  ]
}
{% endschema %}
