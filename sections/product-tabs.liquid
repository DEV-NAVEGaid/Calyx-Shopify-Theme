{% comment %}
  Products in tabs ("Bestsellers"): each tab is a block with a label and a
  collection, and renders that collection's products itself (a section
  can't read its blocks' settings). Pills switch the tab; the arrows scroll
  the row of product cards. assets/product-tabs.js handles the tabs and
  arrows. Small screens show four cards in two columns and a "Shop all"
  button for the tab's collection instead of the scrolling row.

  The "Featured grid" layout shows five products instead: the first large,
  the next four in a two-by-two grid beside it, with the tabs as compact
  labels and no arrows.
{% endcomment %}

{%- assign featured = false -%}
{%- if section.settings.layout == 'featured' -%}
  {%- assign featured = true -%}
{%- endif -%}

<product-tabs class="home-section product-tabs{% if featured %} product-tabs--featured{% endif %} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="product-tabs__header">
      <div class="product-tabs__heading">
        {% if section.settings.eyebrow != blank %}
          <p class="eyebrow product-tabs__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {% endif %}
        {% if section.settings.heading != blank %}
          <h2 class="h3">{{ section.settings.heading | escape }}</h2>
        {% endif %}
      </div>

      <div class="product-tabs__controls">
        {% if section.blocks.size > 0 %}
          <div class="product-tabs__tabs">
            {% content_for 'blocks' %}
          </div>
          {% unless featured %}
            <span class="product-tabs__divider" aria-hidden="true"></span>
          {% endunless %}
        {% endif %}
        {% unless featured %}
          <button class="round-arrow round-arrow--small" type="button" data-scroll-step="-1">
            {% render 'icon', icon: 'chevron-left' %}
            <span class="visually-hidden">{{ 'accessibility.previous_slide' | t }}</span>
          </button>
          <button class="round-arrow round-arrow--small" type="button" data-scroll-step="1">
            {% render 'icon', icon: 'chevron-right' %}
            <span class="visually-hidden">{{ 'accessibility.next_slide' | t }}</span>
          </button>
        {% endunless %}
      </div>
    </div>

    <div class="product-tabs__panels" data-tab-panels></div>
  </div>
</product-tabs>

<script src="{{ 'product-tabs.js' | asset_url }}" type="module"></script>

