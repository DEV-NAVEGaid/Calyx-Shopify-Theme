{% comment %}
  UGC mosaic: a headline stretched across the page, a line of text with
  the community handle, then an edge-to-edge mosaic of photo tiles
  (blocks). Small tiles fill one cell, large tiles two by two.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | strip
  assign heading_length = heading.size | at_least: 6
-%}

<div class="ugc-mosaic spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  {% if heading != blank %}
    <h2 class="ugc-mosaic__headline">
      <fit-text class="ugc-mosaic__title" style="--chars: {{ heading_length }};">{{ heading | escape }}</fit-text>
    </h2>
    {% render 'lazy-script', src: 'fit-text.js' %}
  {% endif %}

  {% if section.settings.text != blank or section.settings.handle != blank %}
    <div class="ugc-mosaic__bar">
      {% if section.settings.text != blank %}
        <p class="ugc-mosaic__text body-l">{{ section.settings.text | escape }}</p>
      {% endif %}
      {% if section.settings.handle != blank %}
        {% if section.settings.handle_link != blank %}
          <a class="ugc-mosaic__handle" href="{{ section.settings.handle_link }}">{{ section.settings.handle | escape }}</a>
        {% else %}
          <p class="ugc-mosaic__handle">{{ section.settings.handle | escape }}</p>
        {% endif %}
      {% endif %}
    </div>
  {% endif %}

  <div class="ugc-mosaic__grid">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.ugc_mosaic",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_ugc-tile"
    },
    {
      "type": "_ugc-campaign"
    }
  ],
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.ugc_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.ugc_text"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:settings.handle",
      "default": "@yourcommunity"
    },
    {
      "type": "url",
      "id": "handle_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
