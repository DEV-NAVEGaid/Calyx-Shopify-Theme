  ],
  "presets": [
    {
      "name": "t:names.mood_grid",
      "category": "t:categories.collections",
      "blocks": {
        "mood_1": {
          "type": "_mood-card",
          "settings": {
            "title": "Calm",
            "text": "t:text_defaults.mood_calm",
            "color": "#dce9e4"
          }
        },
        "mood_2": {
          "type": "_mood-card",
          "settings": {
            "title": "Joy",
            "text": "t:text_defaults.mood_joy",
            "color": "#f8e7c9"
