{% comment %}
  Shop by mood: a heading and the moods as colored blocks linking to a
  product or collection. Cards: a centered heading over a grid of
  numbered cards. Pills: a heading over one row of rounded pills, each
  with the mood and its link label.
{% endcomment %}

<div class="home-section mood-grid mood-grid--{{ section.settings.style }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="mood-grid__header">
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="body-l mood-grid__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    <div class="mood-grid__cards">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.mood_grid",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_mood-card" }],
  "max_blocks": 9,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        { "value": "cards", "label": "t:options.mood_style.cards" },
        { "value": "pills", "label": "t:options.mood_style.pills" }
      ],
      "default": "cards"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.shop_by_mood"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.shop_by_mood_text"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.mood_grid",
      "category": "t:categories.collections",
      "blocks": {
        "mood_1": { "type": "_mood-card", "settings": { "title": "Calm", "text": "t:text_defaults.mood_calm", "color": "#dce9e4" } },
        "mood_2": { "type": "_mood-card", "settings": { "title": "Joy", "text": "t:text_defaults.mood_joy", "color": "#f8e7c9" } },
        "mood_3": { "type": "_mood-card", "settings": { "title": "Confidence", "text": "t:text_defaults.mood_confidence", "color": "#f3d9d2" } }
      },
      "block_order": ["mood_1", "mood_2", "mood_3"]
    }
  ]
}
{% endschema %}
