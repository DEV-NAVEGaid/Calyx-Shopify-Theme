{% comment %}
  Shop by mood: a heading and the moods as colored blocks linking to a
  product or collection. Cards: a centered heading over a grid of
  numbered cards. Pills: a heading over one row of rounded pills, each
  with the mood and its link label.
{% endcomment %}

<div class="home-section mood-grid mood-grid--{{ section.settings.style }} spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="mood-grid__header">
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="body-l mood-grid__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    <div class="mood-grid__cards">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.mood_grid",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_mood-card"
    }
  ],
  "max_blocks": 9,
  "settings": [
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "options": [
        {
          "value": "cards",
          "label": "t:options.mood_style.cards"
        },
        {
          "value": "pills",
          "label": "t:options.mood_style.pills"
        }
      ],
      "default": "cards"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.shop_by_mood"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.shop_by_mood_text"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
