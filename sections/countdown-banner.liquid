{% comment %}
  Countdown banner: eyebrow, heading, text, countdown timer, and button,
  always stacked vertically, left-aligned or centred, on an optional
  background color or gradient.
{% endcomment %}

{%- liquid
  assign classes = 'home-section countdown-banner spacing-style'
  if section.settings.background != blank
    assign classes = classes | append: ' countdown-banner--filled'
  endif
-%}

<div
  class="{{ classes }}"
  style="{% render 'spacing-style', settings: section.settings %}{% if section.settings.background != blank %} --countdown-banner-background: {{ section.settings.background }};{% endif %}{% if section.settings.text_color != blank %} --countdown-banner-text: {{ section.settings.text_color }};{% endif %}"
>
  <div class="home-section__inner countdown-banner__inner section-copy{% if section.settings.alignment == 'center' %} section-copy--center{% endif %}">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.countdown_banner",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_section-eyebrow"
    },
    {
      "type": "_section-heading"
    },
    {
      "type": "_section-text"
    },
    {
      "type": "countdown"
    },
    {
      "type": "_section-button"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.alignment.left"
        },
        {
          "value": "center",
          "label": "t:options.alignment.center"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color_background",
      "id": "background",
      "label": "t:settings.background"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "t:settings.eyebrow_font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "normal",
          "label": "t:options.layout_width.normal"
        },
        {
          "value": "wide",
          "label": "t:options.layout_width.wide"
        }
      ],
      "default": "normal",
      "info": "t:info.layout_width"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.countdown_banner",
      "category": "t:categories.banners",
      "blocks": {
        "eyebrow": {
          "type": "_section-eyebrow",
          "settings": {
            "text": "Holiday edit"
          }
        },
        "heading": {
          "type": "_section-heading",
          "settings": {
            "heading": "The holiday edit ends soon",
            "size": "h1",
            "tag": "h2"
          }
        },
        "text": {
          "type": "_section-text",
          "settings": {
            "text": "<p>Order before the timer runs out for delivery by Christmas.</p>",
            "size": "large"
          }
        },
        "countdown": {
          "type": "countdown",
          "settings": {
            "alignment": "center",
            "style": "editorial"
          }
        },
        "button": {
          "type": "_section-button",
          "settings": {
            "label": "Shop now",
            "style": "primary"
          }
        }
      },
      "block_order": [
        "eyebrow",
        "heading",
        "text",
        "countdown",
        "button"
      ]
    }
  ]
}
{% endschema %}
