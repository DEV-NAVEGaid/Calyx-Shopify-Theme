{% comment %}
  Hero cards: a very large heading, then a line of text with two buttons
  beside a "Loved by" row of customer photos, then a wide photo and a
  narrow photo with a floating card for one product.
{% endcomment %}

{%- liquid
  assign product = section.settings.product
-%}

<div class="home-section hero-cards spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    {% if section.settings.heading != blank %}
      <h1 class="hero-cards__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}

    <div class="hero-cards__intro">
      <div class="hero-cards__copy">
        {% if section.settings.text != blank %}
          <p class="body-l hero-cards__text">{{ section.settings.text | escape }}</p>
        {% endif %}
        <div class="hero-cards__actions">
          {% if section.settings.button_label != blank %}
            <a class="button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a>
          {% endif %}
          {% if section.settings.button_label_2 != blank %}
            <a class="button-secondary" href="{{ section.settings.button_link_2 | default: routes.collections_url }}">{{ section.settings.button_label_2 | escape }}</a>
          {% endif %}
        </div>
      </div>

      {% if section.settings.proof_count != blank %}
        <div class="hero-cards__proof">
          <p>{{ 'content.loved_by' | t }}</p>
          <div class="hero-cards__avatars">
            {% for i in (1..3) %}
              {%- assign setting_id = 'avatar_' | append: i -%}
              {%- assign avatar = section.settings[setting_id] -%}
              {% if avatar != blank %}
                {{ avatar | image_url: width: 80, height: 80 | image_tag: loading: 'lazy', alt: '' }}
              {% endif %}
            {% endfor %}
            <span class="hero-cards__count">{{ section.settings.proof_count | escape }}</span>
          </div>
        </div>
      {% endif %}
    </div>

    <div class="hero-cards__media">
      <div class="hero-cards__card hero-cards__card--wide">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '700, 1000, 1400, 1800', sizes: '(min-width: 990px) 60vw, 100vw', fetchpriority: 'high', alt: section.settings.image.alt }}
        {%- else -%}
          {{ 'lifestyle-1' | placeholder_svg_tag }}
        {%- endif -%}
      </div>
      <div class="hero-cards__card hero-cards__card--narrow">
        {%- if section.settings.image_2 != blank -%}
          {{ section.settings.image_2 | image_url: width: 1000 | image_tag: widths: '480, 720, 1000', sizes: '(min-width: 990px) 480px, 100vw', alt: section.settings.image_2.alt }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag }}
        {%- endif -%}
        {% if product != blank %}
          <a class="hero-cards__product" href="{{ product.url }}">
            <span class="hero-cards__product-media">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 128 | image_tag: loading: 'lazy', alt: '' }}
              {%- endif -%}
            </span>
            <span class="hero-cards__product-text">
              <span class="hero-cards__product-title">{{ product.title | escape }}</span>
              <span class="hero-cards__product-price">
                <span>{{ 'content.price_label' | t }}</span>
                <strong>{% render 'format-money', amount: product.price %}</strong>
              </span>
            </span>
            <span class="hero-cards__product-open" aria-hidden="true">{% render 'icon', icon: 'arrow-right' %}</span>
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.hero_cards",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.hero_cards_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.hero_cards_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "t:text_defaults.shop_now"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:settings.second_button_label",
      "default": "t:text_defaults.hero_cards_button_2"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:settings.second_button_link"
    },
    {
      "type": "header",
      "content": "t:content.loved_by"
    },
    {
      "type": "text",
      "id": "proof_count",
      "label": "t:settings.customer_count",
      "info": "t:info.customer_count",
      "default": "12K+"
    },
    {
      "type": "image_picker",
      "id": "avatar_1",
      "label": "t:settings.customer_photo"
    },
    {
      "type": "image_picker",
      "id": "avatar_2",
      "label": "t:settings.customer_photo"
    },
    {
      "type": "image_picker",
      "id": "avatar_3",
      "label": "t:settings.customer_photo"
    },
    {
      "type": "header",
      "content": "t:content.images"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "t:settings.second_image"
    },
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:info.hero_cards_product"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_cards",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
