{% comment %}
  Contact header: a left-aligned eyebrow, heading and line of text.
{% endcomment %}

<div class="contact-header home-section spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner contact-header__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow contact-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="h1">{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="body-l contact-header__text">{{ section.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.contact_header",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.contact_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.contact_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.contact_text"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.contact_header",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
