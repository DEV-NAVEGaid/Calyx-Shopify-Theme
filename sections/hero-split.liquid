      "info": "t:info.autoplay_off",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 5
    },
    {
      "type": "select",
      "id": "section_height",
      "label": "t:settings.height",
      "options": [
