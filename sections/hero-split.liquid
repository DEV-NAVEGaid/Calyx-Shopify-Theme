{% comment %}
  Hero split: a photo panel with a large heading and a line of text, beside
  a product panel that cycles through featured products (blocks), each
  with its name, a line about it, and a Buy now link
  (assets/hero-split.js). Words in the heading set in italics stay italic.
{% endcomment %}

{%- liquid
  # Only a hero among the page's first two sections is likely to be the
  # largest thing on the first screen: it loads first; a later one waits.
  if section.index <= 2
    assign loading = 'eager'
    assign fetchpriority = 'high'
  else
    assign loading = 'lazy'
    assign fetchpriority = 'auto'
  endif
-%}

<hero-split class="hero-split spacing-style" data-autoplay="{{ section.settings.autoplay }}" style="{% render 'spacing-style', settings: section.settings %} {% render 'hero-height', height: section.settings.section_height %}">
  <div class="hero-split__panel hero-split__panel--image">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 1600 | image_tag: widths: '700, 1000, 1400, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: loading, fetchpriority: fetchpriority, alt: section.settings.image.alt }}
    {%- else -%}
      {% render 'placeholder', name: 'lifestyle-1' %}
    {%- endif -%}
    <div class="hero-split__copy">
      {% if section.settings.heading != blank %}
        <h1 class="display-xl hero-split__heading">{{ section.settings.heading }}</h1>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="hero-split__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>
  </div>

  <div class="hero-split__panel hero-split__panel--products">
    {% content_for 'blocks' %}
    {% if section.blocks.size > 1 %}
      <div class="hero-split__dots" role="tablist" aria-label="{{ 'accessibility.slides' | t }}">
        {% for block in section.blocks %}
          <button
            class="hero-split__dot"
            type="button"
            role="tab"
            aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
            aria-label="{{ 'accessibility.go_to_slide' | t: number: forloop.index }}"
            data-hero-dot="{{ forloop.index0 }}"
          ></button>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</hero-split>

<script src="{{ 'hero-split.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:names.hero_split",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_hero-product"
    }
  ],
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
