        },
        {
          "value": "full_screen",
          "label": "t:options.section_height.full_screen"
        }
      ],
      "default": "medium",
      "visible_if": "{{ section.settings.image_ratio == 'default' }}"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
