{% comment %}
  Contact page: the message form in a bordered card, with the ways to reach
  the studio beside it. Info channels are private blocks. Field ids carry the
  section id so two contact forms on one page don't collide. The FAQ card
  only shows when it has a link.
{% endcomment %}

<div class="contact-form home-section spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner contact-form__layout">
    <div class="contact-form__card">
      {%- assign form_id = 'ContactForm-' | append: section.id -%}
      {% form 'contact', id: form_id, class: 'contact-form__form' %}
        {% if form.posted_successfully? %}
          <p class="contact-form__success" role="status">{{ 'content.contact_success' | t }}</p>
        {% endif %}

        {{ form.errors | default_errors }}

        <div class="contact-form__row">
          <div class="field">
            <label for="ContactName-{{ section.id }}">{{ 'content.contact_name' | t }}</label>
            <input
              class="field__input"
              type="text"
              id="ContactName-{{ section.id }}"
              name="contact[name]"
              autocomplete="name"
              required
            >
          </div>

          <div class="field">
            <label for="ContactEmail-{{ section.id }}">{{ 'content.contact_email' | t }}</label>
            <input
              class="field__input"
              type="email"
              id="ContactEmail-{{ section.id }}"
              name="contact[email]"
              value="{{ form.email }}"
              autocomplete="email"
              required
            >
          </div>
        </div>

        <div class="field">
          <label for="ContactOrder-{{ section.id }}">{{ 'content.contact_order_number' | t }}</label>
          <input class="field__input" type="text" id="ContactOrder-{{ section.id }}" name="contact[order_number]">
        </div>

        <div class="field">
          <label for="ContactSubject-{{ section.id }}">{{ 'content.contact_subject' | t }}</label>
          <input class="field__input" type="text" id="ContactSubject-{{ section.id }}" name="contact[subject]">
        </div>

        <div class="field">
          <label for="ContactTopic-{{ section.id }}">{{ 'content.contact_topic' | t }}</label>
          <select class="field__input" id="ContactTopic-{{ section.id }}" name="contact[topic]">
            <option value="order">{{ 'content.topic_order' | t }}</option>
            <option value="product">{{ 'content.topic_product' | t }}</option>
            <option value="collaboration">{{ 'content.topic_collaboration' | t }}</option>
            <option value="press">{{ 'content.topic_press' | t }}</option>
            <option value="wholesale">{{ 'content.topic_wholesale' | t }}</option>
            <option value="other">{{ 'content.topic_other' | t }}</option>
          </select>
        </div>

        <div class="field">
          <label for="ContactMessage-{{ section.id }}">{{ 'content.contact_message' | t }}</label>
          <textarea
            class="field__input"
            id="ContactMessage-{{ section.id }}"
            name="contact[body]"
            rows="6"
            placeholder="{{ 'content.contact_message_placeholder' | t }}"
            required
          >{{ form.body }}</textarea>
        </div>

        <div class="contact-form__actions">
          <button class="button" type="submit">{{ 'content.contact_send' | t }}</button>
          <p class="contact-form__note">{{ 'content.contact_reply_note' | t }}</p>
        </div>
      {% endform %}
    </div>

    <aside class="contact-info">
      {% content_for 'blocks' %}

      {%- liquid
        assign address = section.settings.address
        if address == blank and shop.address.summary != blank
          assign address = shop.address.summary
        endif
      -%}
      {% if section.settings.hours != blank or address != blank %}
        <div class="contact-info__box">
          <p class="eyebrow">{{ 'content.contact_hours' | t }}</p>
          {% if section.settings.hours != blank %}
            <p class="contact-info__hours">{{ section.settings.hours | escape }}</p>
          {% endif %}
          {% if address != blank %}
            <p class="contact-info__address">{{ address | escape }}</p>
          {% endif %}
        </div>
      {% endif %}

      {% if section.settings.faq_text != blank and section.settings.faq_link != blank %}
        <a class="contact-info__faq" href="{{ section.settings.faq_link }}">
          <span>
            <span class="contact-info__faq-title">{{ section.settings.faq_heading | escape }}</span>
            <span class="contact-info__faq-text">{{ section.settings.faq_text | escape }}</span>
          </span>
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {% endif %}
    </aside>
  </div>
</div>

{% schema %}
{
  "name": "t:names.contact_form",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_contact-channel"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.contact_info"
