{% comment %}
  CTA band: a heading and line of text on the soft accent color, with a
  filled and an outline button on the right.
{% endcomment %}

<div class="cta-band spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner cta-band__inner">
    <div class="cta-band__copy">
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <p class="cta-band__text">{{ section.settings.text | escape }}</p>
      {% endif %}
    </div>

    {% if section.settings.button_label != blank or section.settings.button_label_2 != blank %}
      <div class="cta-band__actions">
        {% if section.settings.button_label != blank %}
          <a class="button" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {% endif %}
        {% if section.settings.button_label_2 != blank %}
          <a class="button-secondary" href="{{ section.settings.button_link_2 | default: routes.collections_url }}">
            {{- section.settings.button_label_2 | escape -}}
          </a>
        {% endif %}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.cta_band",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.cta_heading"
    },
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.cta_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "t:text_defaults.cta_button"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "t:settings.second_button_label",
      "default": "t:text_defaults.cta_button_2"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "t:settings.second_button_link"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "t:names.cta_band",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
