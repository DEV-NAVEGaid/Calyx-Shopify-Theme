{% comment %}
  FAQ body: the topic list beside the groups' headings and accordions.
  assets/faq.js fills the list from the groups' headings (a section cannot
  read its theme blocks' settings). Small screens show the topics as a
  scrolling row of chips.
{% endcomment %}

<div class="home-section faq-body spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner faq-body__inner">
    <nav class="faq-topics" aria-label="{{ 'content.faq_topics' | t }}">
      <p class="faq-topics__label">{{ 'content.faq_topics' | t }}</p>
      <ul class="faq-topics__list" role="list" data-faq-topics></ul>
      <template data-faq-topic-template>
        <li>
          <a class="faq-topics__link" href="#" data-faq-topic>
            <span></span>
            {% render 'icon', icon: 'chevron-right', class: 'faq-topics__icon' %}
          </a>
        </li>
      </template>
    </nav>

    <div class="faq-questions">
      {% content_for 'blocks' %}
      <p class="faq-questions__empty" hidden data-faq-empty>{{ 'content.faq_no_results' | t }}</p>
    </div>
  </div>
</div>

<script src="{{ 'faq.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:names.faq_body",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_faq-group"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
