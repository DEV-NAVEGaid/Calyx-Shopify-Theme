{% comment %}
  Image with text: an eyebrow, heading, text, and a button or arrow link
  beside a photo.
{% endcomment %}

<div class="home-section image-with-text spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner image-with-text__inner image-with-text__inner--image-{{ section.settings.image_position }}">
    <div class="image-with-text__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow image-with-text__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="image-with-text__text body-l">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.button_label != blank %}
        {%- assign button_link = section.settings.button_link | default: routes.all_products_collection_url -%}
        {% if section.settings.button_style == 'link' %}
          <a class="arrow-link" href="{{ button_link }}">
            {{- section.settings.button_label | escape -}}
            {% render 'icon', icon: 'arrow-right' %}
          </a>
        {% else %}
          <a class="button-dark" href="{{ button_link }}">
            {{- section.settings.button_label | escape -}}
          </a>
        {% endif %}
      {% endif %}
    </div>

    <div class="image-with-text__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
      {%- else -%}
        {{ 'product-3' | placeholder_svg_tag }}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.image_with_text",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.media_position",
      "options": [
        { "value": "left", "label": "t:options.position.left" },
        { "value": "right", "label": "t:options.position.right" }
      ],
      "default": "right"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.origin_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.origin_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.origin_text"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "t:text_defaults.explore_collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "t:settings.link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "t:settings.button_style",
      "options": [
        { "value": "button", "label": "t:options.link_style.button" },
        { "value": "link", "label": "t:options.link_style.link" }
      ],
      "default": "button"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.image_with_text",
      "category": "t:categories.storytelling"
    }
  ]
}
{% endschema %}
