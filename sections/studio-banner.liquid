{% comment %}
  Studio banner: a wide photo with a dark overlay and copy on the left.
{% endcomment %}

<div class="studio-banner home-section spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner studio-banner__card">
    <div class="studio-banner__media">
      {%- if section.settings.image != blank -%}
        {{ section.settings.image | image_url: width: 2752 | image_tag: widths: '750, 1100, 1500, 2200, 2752', sizes: '100vw', loading: 'lazy', alt: '' }}
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      {%- endif -%}
    </div>

    <div class="studio-banner__content">
      {% if section.settings.heading != blank %}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="body-l studio-banner__text">{{ section.settings.text }}</div>
      {% endif %}

      {% if section.settings.link_label != blank %}
        <a class="arrow-link" href="{{ section.settings.link | default: routes.root_url }}">
          {{- section.settings.link_label | escape -}}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.studio_banner",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.studio_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.studio_text"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.button_label",
      "default": "t:text_defaults.studio_link"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.studio_banner",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
