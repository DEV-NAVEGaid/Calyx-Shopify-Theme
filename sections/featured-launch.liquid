{% comment %}
  Spotlight on one product: a large photo beside its name, tagline,
  description, scent notes (blocks), a proof point, and two calls to
  action. Name, price, photo, and description come from the product unless
  the section overrides them.
{% endcomment %}

{%- liquid
  assign product = section.settings.product
  assign image = section.settings.image | default: product.featured_image
  assign placeholder_title = 'content.product_title_placeholder' | t
  assign heading = section.settings.heading | default: product.title | default: placeholder_title
  capture price
    render 'format-money', amount: product.price
  endcapture
-%}

<div class="home-section featured-launch spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner featured-launch__inner">
    <div class="featured-launch__media">
      {% if image != blank %}
        {{ image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'lazy', alt: image.alt }}
      {% else %}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="featured-launch__copy">
      {% if section.settings.badge != blank %}
        <span class="badge badge--tag">{{ section.settings.badge | escape }}</span>
      {% endif %}

      <h2 class="h1">{{ heading | escape }}</h2>

      {% if section.settings.subtitle != blank %}
        <p class="featured-launch__subtitle heading-italic">{{ section.settings.subtitle | escape }}</p>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="body-l rte">{{ section.settings.text }}</div>
      {% elsif product.description != blank %}
        <p class="body-l">{{ product.description | strip_html | truncatewords: 30 }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="scent-notes">
          {% content_for 'blocks' %}
        </div>
      {% endif %}

      {% if section.settings.stat_value != blank %}
        <div class="featured-launch__stat">
          <span class="featured-launch__stat-value h1">{{ section.settings.stat_value | escape }}</span>
          <p>{{ section.settings.stat_text | escape }}</p>
        </div>
      {% endif %}

      <div class="featured-launch__actions">
        <a class="button-dark" href="{{ product.url | default: routes.all_products_collection_url }}">
          {%- if product != blank -%}
            {{ 'actions.shop_product_with_price' | t: product: heading, price: price }}
          {%- else -%}
            {{ 'actions.shop_now' | t }}
          {%- endif -%}
        </a>
        {% if section.settings.link_label != blank %}
          <a class="arrow-link" href="{{ section.settings.link | default: product.url }}">
            {{- section.settings.link_label | escape -}}
            {% render 'icon', icon: 'arrow-right' %}
          </a>
        {% endif %}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.featured_launch",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_scent-note" }],
  "max_blocks": 4,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "t:info.featured_launch_image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.badge",
      "default": "t:text_defaults.new_arrival"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.featured_launch_heading"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "t:settings.subtitle",
      "default": "t:text_defaults.featured_launch_subtitle"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:info.featured_launch_text"
    },
    {
      "type": "header",
      "content": "t:content.proof_point"
    },
    {
      "type": "text",
      "id": "stat_value",
      "label": "t:settings.number",
      "default": "6–8h"
    },
    {
      "type": "text",
      "id": "stat_text",
      "label": "t:settings.text",
      "default": "t:text_defaults.featured_launch_stat"
    },
    {
      "type": "header",
      "content": "t:content.secondary_link"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "t:settings.link_label",
      "default": "t:text_defaults.try_a_mini"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.featured_launch",
      "category": "t:categories.products",
      "blocks": {
        "note_1": { "type": "_scent-note", "settings": { "label": "t:text_defaults.note_top", "value": "t:text_defaults.note_top_value" } },
        "note_2": { "type": "_scent-note", "settings": { "label": "t:text_defaults.note_heart", "value": "t:text_defaults.note_heart_value" } },
        "note_3": { "type": "_scent-note", "settings": { "label": "t:text_defaults.note_base", "value": "t:text_defaults.note_base_value" } }
      },
      "block_order": ["note_1", "note_2", "note_3"]
    }
  ]
}
{% endschema %}
