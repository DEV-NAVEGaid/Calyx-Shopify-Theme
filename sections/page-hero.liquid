{% comment %}
  Page hero: a wide photo with a centered eyebrow, heading, and line of
  text. Without a heading it shows the page title.
{% endcomment %}

{%- liquid
  assign heading = section.settings.heading | default: page.title
-%}

<div class="page-hero spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="page-hero__media">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1500, 2200, 2880', sizes: '100vw', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="page-hero__content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}
    {% if heading != blank %}
      <h1 class="display-xl">{{ heading | escape }}</h1>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="page-hero__text body-l">{{ section.settings.text }}</div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.page_hero",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.about_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "info": "t:info.page_hero_heading",
      "default": "t:text_defaults.about_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.about_text"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.page_hero",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
