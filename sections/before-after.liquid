{% comment %}
  Before / after results. Left: a drag-to-compare photo pair with
  thumbnails to switch between pairs (each pair is a block). Right: the
  results column, a static block whose stats are its own blocks.
  assets/before-after.js handles the slider and thumbnails.
{% endcomment %}

<before-after class="home-section before-after spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner before-after__inner">
    <div class="before-after__comparisons">
      {% content_for 'blocks' %}
    </div>
    {% content_for 'block', type: '_results', id: 'results' %}
  </div>
</before-after>

<script src="{{ 'before-after.js' | asset_url }}" type="module"></script>

