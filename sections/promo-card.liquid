{% comment %}
  A soft-colored promo card: copy, price, and a button on one side; a
  photo on the other. With a product chosen, the price and link come from
  it.
{% endcomment %}

{%- liquid
  assign product = section.settings.product
  assign link = section.settings.link | default: product.url | default: routes.all_products_collection_url
  assign image = section.settings.image | default: product.featured_image
-%}

<div class="home-section promo-card spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner promo-card__card">
    <div class="promo-card__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow promo-card__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="body-l promo-card__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if product != blank or section.settings.price_note != blank %}
        <p class="promo-card__price">
          {% if product != blank %}
            <span class="h3">{% render 'format-money', amount: product.price %}</span>
          {% endif %}
          {% if section.settings.price_note != blank %}
            <span class="promo-card__price-note">{{ section.settings.price_note | escape }}</span>
          {% endif %}
        </p>
      {% endif %}
      {% if section.settings.button_label != blank %}
        <a class="button" href="{{ link }}">{{ section.settings.button_label | escape }}</a>
      {% endif %}
    </div>

    <div class="promo-card__media">
      {% if image != blank %}
        {{ image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 60vw, 100vw', loading: 'lazy', alt: image.alt }}
      {% else %}
        {{ 'lifestyle-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.promo_card",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product",
      "info": "t:info.promo_product"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.promo_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.promo_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.promo_text"
    },
    {
      "type": "text",
      "id": "price_note",
      "label": "t:settings.price_note",
      "default": "t:text_defaults.promo_price_note"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "t:text_defaults.shop_now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.promo_link"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.promo_card",
      "category": "t:categories.banners"
    }
  ]
}
{% endschema %}
