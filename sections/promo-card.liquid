{% comment %}
  A soft-colored promo card: copy blocks (eyebrow, heading, text, price,
  button) on one side; a photo on the other. With a product chosen, the
  price, photo and button link come from it.
{% endcomment %}

{%- liquid
  assign product = section.settings.product
  assign image = section.settings.image | default: product.featured_image
-%}

<div class="home-section promo-card spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner promo-card__card">
    <div class="promo-card__copy section-copy">
      {% content_for 'blocks' %}
    </div>

    <div class="promo-card__media">
      {% if image != blank %}
        {{ image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 60vw, 100vw', loading: 'lazy', alt: image.alt }}
      {% else %}
        {% render 'placeholder', name: 'lifestyle-2' %}
      {% endif %}
    </div>
  </div>
</div>

