{% comment %}
  The main product section: media gallery and product details side by side,
  as static blocks, followed by any extra blocks.
{% endcomment %}

<div
  class="section section--page-width spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
>
  <div
    class="section-content product-information product-information--media-{{ section.settings.media_position }}"
    style="{% render 'gap-style', value: section.settings.gap %}"
  >
    {% content_for 'block', type: '_product-media-gallery', id: 'media-gallery' %}
    {% content_for 'block', type: '_product-details', id: 'product-details' %}

    <div class="product-information__additional layout-panel">
      {% content_for 'blocks' %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.product_information",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "settings": [
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.position.left"
        },
        {
          "value": "right",
          "label": "t:options.position.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ]
}
{% endschema %}
