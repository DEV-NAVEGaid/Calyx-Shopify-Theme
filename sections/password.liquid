{% comment %}
  The password (coming soon) page: a full-screen photo with the store
  name, a badge, a heading and line of text, an email sign-up, and social
  links. "Enter using password" opens the password form in a dialog,
  which opens by itself after a wrong password (assets/password.js).
{% endcomment %}

{%- liquid
  assign text = section.settings.text | default: shop.password_message
  assign networks = 'instagram,tiktok,pinterest,facebook,youtube,x' | split: ','
-%}

<div class="password-page">
  <div class="password-page__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1500, 2200, 2880', sizes: '100vw', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      {% render 'placeholder', name: 'lifestyle-2' %}
    {%- endif -%}
  </div>

  <div class="password-page__content">
    <p class="password-page__brand">{{ shop.name | escape }}</p>
    {% if section.settings.badge != blank %}
      <span class="badge badge--tag">{{ section.settings.badge | escape }}</span>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="display-xl">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if text != blank %}
      <p class="body-l password-page__text">{{ text | escape }}</p>
    {% endif %}

    {% if section.settings.show_newsletter %}
      {%- capture notify_label -%}{{ 'actions.notify_me' | t }}{%- endcapture -%}
      {% render 'newsletter-form', id: 'PasswordNewsletter', button_label: notify_label, button_class: 'button-light' %}
    {% endif %}

    {% if section.settings.show_social %}
      <ul class="password-page__social" role="list">
        {% for network in networks %}
          {%- assign setting_id = 'social_' | append: network | append: '_link' -%}
          {%- assign link = settings[setting_id] -%}
          {% if link != blank %}
            {%- assign label_key = 'blocks.social_links.' | append: network -%}
            <li><a href="{{ link }}" target="_blank" rel="noopener">{{ label_key | t }}</a></li>
          {% endif %}
        {% endfor %}
      </ul>
    {% endif %}
  </div>

  <div class="password-page__footer">
    <p>
      {{ 'content.store_owner' | t }}
      <button class="button-unstyled password-page__enter" type="button" data-password-open>{{ 'actions.enter_using_password' | t }}</button>
    </p>
    <p class="password-page__powered">{{ powered_by_link }}</p>
  </div>

  {% form 'storefront_password', class: 'password-dialog__form' %}
    <dialog class="password-dialog" data-password-dialog {% if form.errors %}data-open-on-load{% endif %} aria-labelledby="PasswordDialogTitle">
      <button class="button-unstyled password-dialog__close" type="button" data-password-close>
        {% render 'icon', icon: 'close' %}
        <span class="visually-hidden">{{ 'accessibility.close' | t }}</span>
      </button>
      <p class="password-page__brand">{{ shop.name | escape }}</p>
      <h2 class="h3" id="PasswordDialogTitle">{{ 'content.enter_store_password' | t }}</h2>
      <div class="field">
        <label for="PasswordInput">{{ 'content.password' | t }}</label>
        <input
          class="field__input"
          type="password"
          name="password"
          id="PasswordInput"
          autocomplete="current-password"
          required
          {% if form.errors %}
            aria-invalid="true" aria-describedby="PasswordError"
          {% endif %}
        >
        {% if form.errors %}
          <p class="password-dialog__error" id="PasswordError">{{ 'content.password_incorrect' | t }}</p>
        {% endif %}
      </div>
      <button class="button-dark" type="submit">{{ 'actions.enter' | t }}</button>
      <p class="password-dialog__admin">
        {{ 'content.are_you_owner' | t }}
        <a href="/admin">{{ 'content.log_in_here' | t }}</a>
      </p>
    </dialog>
  {% endform %}
</div>

<script src="{{ 'password.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:names.password",
  "class": "section-wrapper",
  "tag": "section",
  "enabled_on": {
    "templates": ["password"]
  },
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "t:settings.badge",
      "default": "t:text_defaults.opening_soon"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.password_heading"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "t:settings.text",
      "info": "t:info.password_text"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "t:settings.show_newsletter",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "t:settings.show_social_links",
      "info": "t:info.social_links_from_settings",
      "default": true
    }
  ]
}
{% endschema %}
