{% comment %}
  Stockists: the partner stores that carry the brand. A search field, "Use
  my location", and filter chips sit over a list of store cards beside a
  drawn map with a numbered pin for each store. Stores are blocks; the copy
  above them is static blocks. assets/stockists.js filters the list, sorts
  it by distance once the customer shares their location, and keeps the
  selected card and pin in step.
{% endcomment %}

<stockists-locator
  class="home-section stockists spacing-style"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-unit="{{ section.settings.distance_unit }}"
  data-count-one="{{ 'content.stockists_count_one' | t }}"
  data-count-other="{{ 'content.stockists_count_other' | t }}"
  data-count-near="{{ 'content.stockists_count_near' | t }}"
  data-open-today="{{ 'content.stockists_open_today' | t }}"
  data-closed-today="{{ 'content.stockists_closed_today' | t }}"
  data-distance="{% if section.settings.distance_unit == 'km' %}{{ 'content.distance_km' | t }}{% else %}{{ 'content.distance_mi' | t }}{% endif %}"
  data-location-error="{{ 'content.stockists_location_error' | t }}"
>
  <div class="home-section__inner stockists__inner">
    <div class="stockists__intro section-copy">
      {% content_for 'block', type: '_section-eyebrow', id: 'eyebrow' %}
      {% content_for 'block', type: '_section-heading', id: 'heading' %}
      {% content_for 'block', type: '_section-text', id: 'text' %}
    </div>

    <div class="stockists__controls">
      <label class="stockists__search">
        {% render 'icon', icon: 'search', class: 'stockists__search-icon' %}
        <input
          type="search"
          class="stockists__search-input"
          name="stockists-search"
          placeholder="{{ 'content.stockists_search_placeholder' | t }}"
          aria-label="{{ 'content.stockists_search_placeholder' | t }}"
          autocomplete="off"
          data-stockists-search
        >
      </label>
      <button type="button" class="button-secondary stockists__locate" data-stockists-locate>
        {{- 'actions.use_my_location' | t -}}
      </button>
    </div>
    <p class="stockists__message" role="status" hidden data-stockists-message></p>

    {% if section.settings.show_filters %}
      <div class="stockists__filters" role="group" aria-label="{{ 'content.stockists_filters' | t }}">
        <button type="button" class="mood-filters__chip mood-filters__chip--active" aria-pressed="true" data-filter="all">
          {{- 'content.stockists_all' | t -}}
        </button>
        <button type="button" class="mood-filters__chip" aria-pressed="false" data-filter="full">
          {{- section.settings.filter_full_label | escape -}}
        </button>
        <button type="button" class="mood-filters__chip" aria-pressed="false" data-filter="discovery">
          {{- section.settings.filter_discovery_label | escape -}}
        </button>
      </div>
    {% endif %}

    <div class="stockists__body">
      <div class="stockists__results">
        <p class="stockists__count" aria-live="polite" data-stockists-count></p>
        <ol class="stockists__list" role="list" data-stockists-list>
          {% content_for 'blocks' %}
        </ol>
        <p class="stockists__empty" hidden data-stockists-empty>{{ 'content.stockists_empty' | t }}</p>
      </div>

      <div class="stockists__map" role="region" aria-label="{{ 'accessibility.store_map' | t }}" data-stockists-map>
        <div class="stockists__pins" data-stockists-pins></div>
        <div class="stockists__popup" hidden data-stockists-popup>
          <strong class="stockists__popup-name" data-stockists-popup-name></strong>
          <span class="stockists__popup-meta" data-stockists-popup-meta></span>
        </div>
        <div class="stockists__zoom">
          <button type="button" class="stockists__zoom-button" data-stockists-zoom="1">
            {% render 'icon', icon: 'plus' %}
            <span class="visually-hidden">{{ 'accessibility.zoom_in' | t }}</span>
          </button>
          <button type="button" class="stockists__zoom-button" data-stockists-zoom="-1">
            {% render 'icon', icon: 'minus' %}
            <span class="visually-hidden">{{ 'accessibility.zoom_out' | t }}</span>
          </button>
        </div>
      </div>
    </div>
  </div>
</stockists-locator>

{% render 'lazy-script', src: 'stockists.js' %}

