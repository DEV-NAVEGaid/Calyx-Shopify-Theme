{% comment %}
  Journal teaser: a heading with a link to the blog, then the latest
  articles as cards. Each card is the static blog post card block, so its
  settings apply to every card.
{% endcomment %}

{%- liquid
  assign blog = section.settings.blog
-%}

<div class="home-section journal-teaser spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="journal-teaser__header">
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if blog != blank %}
        <a class="arrow-link" href="{{ blog.url }}">
          {{- 'content.view_all_stories' | t -}}
          {% render 'icon', icon: 'arrow-right' %}
        </a>
      {% endif %}
    </div>

    <div class="journal-teaser__grid">
      {% if blog != blank and blog.articles_count > 0 %}
        {% for article in blog.articles limit: section.settings.count %}
          {% content_for 'block', type: '_blog-post-card', id: 'blog-post-card', closest.article: article %}
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.count) %}
          <article class="blog-post-card">
            <div class="blog-post-card__media">
              {{ 'lifestyle-2' | placeholder_svg_tag }}
            </div>
            <div class="blog-post-card__body">
              <h3 class="blog-post-card__title h4">{{ 'content.article_title_placeholder' | t }}</h3>
            </div>
          </article>
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
