{% comment %}
  A photo beside numbered steps ("Breathe. Spray. Say."): eyebrow,
  heading, text, and one block per step.
{% endcomment %}

<div class="home-section ritual-steps spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner ritual-steps__inner ritual-steps__inner--image-{{ section.settings.image_position }} ritual-steps__inner--{{ section.settings.number_style }}">
    <div class="ritual-steps__media">
      {% if section.settings.image != blank %}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 990px) 600px, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
      {% else %}
        {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
      {% endif %}
    </div>

    <div class="ritual-steps__copy">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow ritual-steps__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="h2">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.text != blank %}
        <div class="body-l ritual-steps__text">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.blocks.size > 0 %}
        <ol class="ritual-steps__list" role="list">
          {% content_for 'blocks' %}
        </ol>
      {% endif %}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "t:names.ritual_steps",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_ritual-step"
    }
  ],
  "max_blocks": 6,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.position.left"
        },
        {
          "value": "right",
          "label": "t:options.position.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "number_style",
      "label": "t:settings.number_style",
      "options": [
        {
          "value": "circle",
          "label": "t:options.number_style.circle"
        },
        {
          "value": "numeral",
          "label": "t:options.number_style.numeral"
        }
      ],
      "default": "circle"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.ritual_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.ritual_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:html_defaults.ritual_text"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "label": "t:settings.eyebrow_font_size",
      "min": 8,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 12,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "eyebrow_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "header",
      "content": "t:content.section_layout"
    },
    {
      "type": "select",
      "id": "layout_width",
      "label": "t:settings.width",
