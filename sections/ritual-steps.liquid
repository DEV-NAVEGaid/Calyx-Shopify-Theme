          "label": "t:options.layout_width.wide"
        }
      ],
      "default": "normal",
      "info": "t:info.layout_width"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.image_ratio",
      "options": [
        {
          "value": "default",
          "label": "t:options.image_ratio.default"
        },
        {
          "value": "square",
          "label": "t:options.image_ratio.square"
        },
        {
          "value": "portrait",
          "label": "t:options.image_ratio.portrait"
        },
        {
          "value": "tall",
          "label": "t:options.image_ratio.tall"
        },
        {
          "value": "landscape",
          "label": "t:options.image_ratio.landscape"
        },
        {
          "value": "wide",
          "label": "t:options.image_ratio.wide"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.ritual_steps",
      "category": "t:categories.storytelling",
      "blocks": {
        "step_1": {
          "type": "_ritual-step",
          "settings": {
            "title": "t:text_defaults.step_1",
            "text": "t:text_defaults.step_1_text"
          }
        },
        "step_2": {
          "type": "_ritual-step",
          "settings": {
            "title": "t:text_defaults.step_2",
            "text": "t:text_defaults.step_2_text"
          }
        },
        "step_3": {
          "type": "_ritual-step",
          "settings": {
            "title": "t:text_defaults.step_3",
            "text": "t:text_defaults.step_3_text"
          }
        }
      },
      "block_order": [
        "step_1",
        "step_2",
        "step_3"
      ]
    }
  ]
}
{% endschema %}
