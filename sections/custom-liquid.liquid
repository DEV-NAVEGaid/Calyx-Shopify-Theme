{% comment %}
  A section for merchant-provided Liquid, such as app snippets or embeds.
{% endcomment %}

<div
  class="section section--page-width spacing-style"
  style="
    {% render 'spacing-style', settings: section.settings %}
    {% if section.settings.background_color != blank %}--section-background: {{ section.settings.background_color }};{% endif %}
    {% if section.settings.text_color != blank %}--section-text-color: {{ section.settings.text_color }};{% endif %}
    
  "
>
  <div class="section-content custom-liquid">
    {{ section.settings.custom_liquid }}
  </div>
</div>

{% schema %}
{
  "name": "t:names.custom_liquid",
  "class": "section-wrapper",
  "tag": "section",
  "settings": [
    {
      "type": "liquid",
      "id": "custom_liquid",
      "label": "t:settings.liquid",
      "info": "t:info.custom_liquid"
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "alpha": true
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "t:settings.text_color"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 32
    }
  ],
  "presets": [
    {
      "name": "t:names.custom_liquid",
      "category": "t:categories.layout"
    }
  ]
}
{% endschema %}
