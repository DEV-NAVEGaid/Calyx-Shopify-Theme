{% comment %}
  USP strip: a bordered row of short promises (blocks), each an icon with a
  title and a line of detail.
{% endcomment %}

<div class="home-section usp-strip spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="usp-strip__items">
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.usp_strip",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_usp-item" }],
  "max_blocks": 6,
  "settings": [
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    }
  ],
  "presets": [
    {
      "name": "t:names.usp_strip",
      "category": "t:categories.text",
      "blocks": {
        "usp_1": { "type": "_usp-item", "settings": { "icon": "truck", "title": "t:text_defaults.usp_1", "text": "t:text_defaults.usp_1_text" } },
        "usp_2": { "type": "_usp-item", "settings": { "icon": "gift", "title": "t:text_defaults.usp_2", "text": "t:text_defaults.usp_2_text" } },
        "usp_3": { "type": "_usp-item", "settings": { "icon": "leaf", "title": "t:text_defaults.usp_3", "text": "t:text_defaults.usp_3_text" } },
        "usp_4": { "type": "_usp-item", "settings": { "icon": "sparkle", "title": "t:text_defaults.usp_4", "text": "t:text_defaults.usp_4_text" } }
      },
      "block_order": ["usp_1", "usp_2", "usp_3", "usp_4"]
    }
  ]
}
{% endschema %}
