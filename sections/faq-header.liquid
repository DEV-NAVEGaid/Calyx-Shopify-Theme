{% comment %}
  FAQ header: a centred eyebrow, heading and intro over a search field that
  filters the answers in the body section.
{% endcomment %}

<div class="home-section faq-header spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner faq-header__inner">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow faq-header__eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    {% if section.settings.heading != blank %}
      <h1 class="h1 faq-header__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}

    {% if section.settings.text != blank %}
      <div class="body-l faq-header__text rte">{{ section.settings.text }}</div>
    {% endif %}

    <label class="faq-search">
      {% render 'icon', icon: 'search', class: 'faq-search__icon' %}
      <input
        type="search"
        class="faq-search__input"
        name="faq-search"
        placeholder="{{ 'content.faq_search_placeholder' | t }}"
        aria-label="{{ 'content.faq_search_placeholder' | t }}"
        autocomplete="off"
        data-faq-search
      >
    </label>
  </div>
</div>

{% schema %}
{
  "name": "t:names.faq_header",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.faq_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.faq_heading"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "t:text_defaults.faq_text"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:names.faq_header",
      "category": "t:categories.text"
    }
  ]
}
{% endschema %}
