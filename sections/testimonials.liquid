{% comment %}
  Reviews: a centered eyebrow and heading, an overall rating line, and a
  row of review cards (blocks). On small screens the cards swipe one at a
  time, with dots (assets/scroll-dots.js).
{% endcomment %}

<div class="home-section testimonials spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="testimonials__header">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.rating_text != blank %}
        <p class="testimonials__summary">
          {% render 'rating-stars', rating: section.settings.rating, max: 5 %}
          <span>{{ section.settings.rating_text | escape }}</span>
        </p>
      {% endif %}
    </div>

    <div class="testimonials__cards" id="TestimonialCards-{{ section.id }}">
      {% content_for 'blocks' %}
    </div>

    {% if section.blocks.size > 1 %}
      <scroll-dots class="scroll-dots testimonials__dots" data-for="TestimonialCards-{{ section.id }}">
        {% for block in section.blocks %}
          <button
            class="scroll-dots__dot"
            type="button"
            aria-label="{{ 'accessibility.go_to_slide' | t: number: forloop.index }}"
            {% if forloop.first %}
              aria-current="true"
            {% endif %}
          ></button>
        {% endfor %}
      </scroll-dots>
      {% render 'lazy-script', src: 'scroll-dots.js' %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.testimonials",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_testimonial"
    }
  ],
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.reviews_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.reviews_heading"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "t:settings.rating",
      "min": 1,
      "max": 5,
      "step": 0.1,
      "default": 4.8
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "t:settings.rating_text",
      "default": "t:text_defaults.reviews_summary"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
