{% comment %}
  Notes grid: a centered eyebrow and heading over a row of notes (blocks),
  each a colored circle or photo, the note's name, and the feeling it
  brings.
{% endcomment %}

<div class="home-section notes-grid spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="notes-grid__header">
      {% if section.settings.eyebrow != blank %}
        <p class="eyebrow notes-grid__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}
      {% if section.settings.heading != blank %}
        <h2 class="h3">{{ section.settings.heading | escape }}</h2>
      {% endif %}
    </div>
    <ul class="notes-grid__list" role="list">
      {% content_for 'blocks' %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:names.notes_grid",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_note"
    }
  ],
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.notes_eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
