{% comment %}
  The search page. With results: the heading, search field, result count,
  and chips that jump to each kind of result, then products (with filter
  pills, sorting, and load more), articles, and pages. Without results: a
  friendly empty state with the search field and popular searches, then
  suggested products from a collection. Products render through the static
  product card, articles through the static blog post card.
{% endcomment %}

{%- liquid
  assign terms = search.terms | escape
  assign popular = section.settings.popular_searches | split: ','
  assign suggested = section.settings.suggested_collection
-%}

{%- capture search_input -%}
  {%- content_for 'block', type: '_search-input', id: 'search-input' -%}
{%- endcapture -%}

<div class="home-section search-results spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    {% if search.performed and search.results_count == 0 %}
      <div class="search-results__empty">
        <span class="empty-state__icon">{% render 'icon', icon: 'search' %}</span>
        <h1 class="h2">{{ 'content.search_no_results_title' | t: terms: terms }}</h1>
        <p class="body-l">{{ 'content.search_no_results_text' | t }}</p>
        {{ search_input }}
        {% render 'search-popular', terms: popular %}
      </div>

      {% if suggested != blank %}
        <div class="search-results__suggested">
          {% if section.settings.suggested_heading != blank %}
            <h2 class="h3">{{ section.settings.suggested_heading | escape }}</h2>
          {% endif %}
          <ul class="product-grid" role="list" style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};">
            {% for product in suggested.products limit: section.settings.columns_desktop %}
              <li>{% content_for 'block', type: 'product-card', id: 'suggested-product-card', closest.product: product %}</li>
            {% endfor %}
          </ul>
        </div>
      {% endif %}
    {% else %}
      <div class="search-results__header">
        <h1 class="h2">{{ 'content.search' | t }}</h1>
        {{ search_input }}
        {% unless search.performed %}
          {% render 'search-popular', terms: popular %}
        {% endunless %}
      </div>

      {% if search.performed %}
        {% paginate search.results by section.settings.results_per_page %}
          {%- liquid
            assign products = search.results | where: 'object_type', 'product'
            assign articles = search.results | where: 'object_type', 'article'
            assign pages = search.results | where: 'object_type', 'page'
          -%}

          <p class="search-results__count" role="status">
            {{ 'content.search_results_count_html' | t: count: search.results_count, terms: terms }}
          </p>
          <ul class="search-results__jumps" role="list">
            {% if products.size > 0 %}
              <li><a class="search-results__jump" href="#SearchProducts">{{ 'content.search_products_count' | t: count: products.size }}</a></li>
            {% endif %}
            {% if articles.size > 0 %}
              <li><a class="search-results__jump" href="#SearchArticles">{{ 'content.search_articles_count' | t: count: articles.size }}</a></li>
            {% endif %}
            {% if pages.size > 0 %}
              <li><a class="search-results__jump" href="#SearchPages">{{ 'content.search_pages_count' | t: count: pages.size }}</a></li>
            {% endif %}
          </ul>

          {% if products.size > 0 or search.filters.size > 0 %}
            <div class="search-results__products" id="SearchProducts">
              <h2 class="h4 search-results__heading">{{ 'content.products' | t }}</h2>
              {% content_for 'block', type: 'filters', id: 'filters' %}
              <ul class="product-grid" role="list" style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: {{ section.settings.columns_mobile }};">
                {% for result in products %}
                  <li>{% content_for 'block', type: 'product-card', id: 'product-card', closest.product: result %}</li>
                {% endfor %}
              </ul>
            </div>
          {% endif %}

          {% if articles.size > 0 or pages.size > 0 %}
            <div class="search-results__content">
              {% if articles.size > 0 %}
                <div class="search-results__articles" id="SearchArticles">
                  <h2 class="h4 search-results__heading">{{ 'content.articles' | t }}</h2>
                  <ul class="search-results__article-grid" role="list">
                    {% for result in articles %}
                      <li>{% content_for 'block', type: '_blog-post-card', id: 'blog-post-card', closest.article: result %}</li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
              {% if pages.size > 0 %}
                <div class="search-results__pages" id="SearchPages">
                  <h2 class="h4 search-results__heading">{{ 'content.pages' | t }}</h2>
                  <ul class="search-results__page-list" role="list">
                    {% for result in pages %}
                      <li>
                        <a class="search-page-card" href="{{ result.url }}">
                          <span class="search-page-card__text">
                            <span class="search-page-card__title">{{ result.title | escape }}</span>
                            <span class="search-page-card__excerpt">{{ result.content | strip_html | truncatewords: 14 }}</span>
                          </span>
                          {% render 'icon', icon: 'chevron-right' %}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                </div>
              {% endif %}
            </div>
          {% endif %}

          {%- assign shown = paginate.current_offset | plus: search.results.size -%}
          <div class="main-collection__more">
            <p class="main-collection__count">
              {{ 'content.showing_results' | t: shown: shown, total: paginate.items }}
            </p>
            <span class="main-collection__bar" aria-hidden="true">
              <span style="width: {{ shown | times: 100 | divided_by: paginate.items }}%;"></span>
            </span>
            {% if paginate.next %}
              <a class="button-secondary" href="{{ paginate.next.url }}">{{ 'actions.load_more' | t }}</a>
            {% endif %}
          </div>
        {% endpaginate %}
      {% endif %}
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.search_results",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "range",
      "id": "results_per_page",
      "label": "t:settings.results_per_page",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "text",
      "id": "popular_searches",
      "label": "t:settings.popular_searches",
      "info": "t:info.popular_searches",
      "default": "t:text_defaults.popular_searches"
    },
    {
      "type": "header",
      "content": "t:content.no_results"
    },
    {
      "type": "text",
      "id": "suggested_heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.suggested_heading"
    },
    {
      "type": "collection",
      "id": "suggested_collection",
      "label": "t:settings.collection",
      "info": "t:info.suggested_collection"
    },
    {
      "type": "header",
      "content": "t:content.grid"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "t:settings.columns_mobile",
      "options": [
        { "value": "1", "label": "t:options.columns.one" },
        { "value": "2", "label": "t:options.columns.two" }
      ],
      "default": "2"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 96
    }
  ]
}
{% endschema %}
