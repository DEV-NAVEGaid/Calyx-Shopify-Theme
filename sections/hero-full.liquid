{% comment %}
  Hero full: a full-screen photo with a rating line, a heading, and up to
  three short promises with icons along the bottom. Pair it with Header >
  "Transparent on home" so the header sits over the photo.
{% endcomment %}

<div class="hero-full spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="hero-full__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1500, 2200, 2880', sizes: '100vw', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero-full__content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow hero-full__eyebrow">
        {{ section.settings.eyebrow | escape }}
        {% if section.settings.show_stars %}
          <span class="hero-full__stars" aria-hidden="true">★★★★★</span>
        {% endif %}
      </p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero-full__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <ul class="hero-full__features" role="list">
        {% content_for 'blocks' %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.hero_full",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_hero-feature" }],
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.hero_full_eyebrow"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "t:settings.show_stars",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.hero_full_heading"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_full",
      "category": "t:categories.banners",
      "blocks": {
        "feature_1": { "type": "_hero-feature", "settings": { "icon": "leaf", "text": "t:text_defaults.hero_feature_1" } },
        "feature_2": { "type": "_hero-feature", "settings": { "icon": "sparkle", "text": "t:text_defaults.hero_feature_2" } },
        "feature_3": { "type": "_hero-feature", "settings": { "icon": "heart", "text": "t:text_defaults.hero_feature_3" } }
      },
      "block_order": ["feature_1", "feature_2", "feature_3"]
    }
  ]
}
{% endschema %}
