    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.hero_full",
      "category": "t:categories.banners",
      "blocks": {
        "feature_1": {
          "type": "_hero-feature",
          "settings": {
            "icon": "leaf",
            "text": "t:text_defaults.hero_feature_1"
          }
        },
        "feature_2": {
          "type": "_hero-feature",
          "settings": {
            "icon": "sparkle",
            "text": "t:text_defaults.hero_feature_2"
          }
        },
        "feature_3": {
          "type": "_hero-feature",
          "settings": {
            "icon": "heart",
            "text": "t:text_defaults.hero_feature_3"
          }
        }
      },
      "block_order": [
        "feature_1",
        "feature_2",
        "feature_3"
      ]
    }
  ]
}
{% endschema %}
