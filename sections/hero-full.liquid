{% comment %}
  Hero full: a full-screen photo with a rating line, a heading, and up to
  three short promises with icons along the bottom. Pair it with Header >
  "Transparent on home" so the header sits over the photo.
{% endcomment %}

<div class="hero-full spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="hero-full__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2880 | image_tag: widths: '750, 1100, 1500, 2200, 2880', sizes: '100vw', fetchpriority: 'high', alt: '' }}
    {%- else -%}
      {{ 'lifestyle-2' | placeholder_svg_tag }}
    {%- endif -%}
  </div>

  <div class="hero-full__content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow hero-full__eyebrow">
        {{ section.settings.eyebrow | escape }}
        {% if section.settings.show_stars %}
          <span class="hero-full__stars" aria-hidden="true">★★★★★</span>
        {% endif %}
      </p>
    {% endif %}
    {% if section.settings.heading != blank %}
      <h1 class="hero-full__heading">{{ section.settings.heading | escape }}</h1>
    {% endif %}
    {% if section.blocks.size > 0 %}
      <ul class="hero-full__features" role="list">
        {% content_for 'blocks' %}
      </ul>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "t:names.hero_full",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  },
  "blocks": [
    {
      "type": "_hero-feature"
    }
  ],
  "max_blocks": 3,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "t:text_defaults.hero_full_eyebrow"
    },
    {
      "type": "checkbox",
      "id": "show_stars",
      "label": "t:settings.show_stars",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.hero_full_heading"
    },
    {
      "type": "header",
      "content": "t:content.font_sizes"
    },
    {
      "type": "checkbox",
      "id": "custom_font_sizes",
      "label": "t:settings.custom_font_sizes",
      "default": false,
      "info": "t:info.custom_font_sizes"
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "label": "t:settings.heading_font_size",
      "min": 16,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "heading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "label": "t:settings.subheading_font_size",
      "min": 12,
      "max": 64,
      "step": 1,
      "unit": "px",
      "default": 24,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "subheading_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
      "default": "default",
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "range",
      "id": "text_font_size",
      "label": "t:settings.text_font_size",
      "min": 10,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 16,
      "visible_if": "{{ section.settings.custom_font_sizes }}"
    },
    {
      "type": "select",
      "id": "text_font_weight",
      "label": "t:settings.font_weight",
      "options": [
        {
          "value": "default",
          "label": "t:options.font_weight.default"
        },
        {
          "value": "300",
          "label": "t:options.font_weight.light"
        },
        {
          "value": "400",
          "label": "t:options.font_weight.regular"
        },
        {
          "value": "500",
          "label": "t:options.font_weight.medium"
        },
        {
          "value": "600",
          "label": "t:options.font_weight.semibold"
        },
        {
          "value": "700",
          "label": "t:options.font_weight.bold"
        }
      ],
