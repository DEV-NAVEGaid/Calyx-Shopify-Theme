{% comment %}
  Collection spotlight: a tall campaign image with its copy (eyebrow,
  heading, text, link blocks) beside a grid of the collection's product
  cards. With "Keep image in view" on, the image stays pinned below the
  header while the products scroll past; off, it scrolls with the grid.
  The image can sit on either side; small screens stack it above the grid.
{% endcomment %}

{%- liquid
  assign collection = section.settings.collection
  assign image = section.settings.image | default: collection.featured_image

  assign classes = 'home-section collection-spotlight spacing-style collection-spotlight--image-' | append: section.settings.image_position
  if section.settings.sticky_image
    assign classes = classes | append: ' collection-spotlight--sticky'
  endif
  if section.settings.overlay
    assign classes = classes | append: ' collection-spotlight--overlay'
  endif
-%}

<div
  class="{{ classes }}"
  style="{% render 'spacing-style', settings: section.settings %} --spotlight-text: {{ section.settings.text_color }};"
>
  <div class="home-section__inner collection-spotlight__inner">
    <div class="collection-spotlight__media">
      <div class="collection-spotlight__frame">
        {% if image != blank %}
          {{
            image
            | image_url: width: 2000
            | image_tag: widths: '600, 900, 1200, 1600, 2000', sizes: '(min-width: 750px) 50vw, 100vw', loading: 'lazy', alt: image.alt, class: 'collection-spotlight__image'
          }}
        {% else %}
          {{ 'lifestyle-1' | placeholder_svg_tag: 'collection-spotlight__image placeholder-svg' }}
        {% endif %}

        <div class="collection-spotlight__copy section-copy">
          {% content_for 'blocks' %}
        </div>
      </div>
    </div>

    <ul
      class="product-grid collection-spotlight__grid"
      role="list"
      style="--columns-desktop: {{ section.settings.columns_desktop }}; --columns-mobile: 2;"
    >
      {% if collection != blank %}
        {% for product in collection.products limit: section.settings.products_to_show %}
          <li>{% content_for 'block', type: 'product-card', id: 'product-card', closest.product: product %}</li>
        {% endfor %}
      {% else %}
        {% for i in (1..section.settings.products_to_show) %}
          <li>{% content_for 'block', type: 'product-card', id: 'product-card' %}</li>
        {% endfor %}
      {% endif %}
    </ul>
  </div>
</div>

