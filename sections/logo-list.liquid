{% comment %}
  Logo list: a small heading over a row of logos (blocks), such as the
  stores that stock the brand.
{% endcomment %}

<div class="home-section logo-list spacing-style" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    {% if section.settings.heading != blank %}
      <h2 class="eyebrow logo-list__heading">{{ section.settings.heading | escape }}</h2>
    {% endif %}
    <ul class="logo-list__items" role="list">
      {% content_for 'blocks' %}
    </ul>
  </div>
</div>

{% schema %}
{
  "name": "t:names.logo_list",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_logo" }],
  "max_blocks": 10,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.stockists_heading"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 112
    }
  ],
  "presets": [
    {
      "name": "t:names.logo_list",
      "category": "t:categories.storytelling",
      "blocks": {
        "logo_1": { "type": "_logo" },
        "logo_2": { "type": "_logo" },
        "logo_3": { "type": "_logo" },
        "logo_4": { "type": "_logo" },
        "logo_5": { "type": "_logo" }
      },
      "block_order": ["logo_1", "logo_2", "logo_3", "logo_4", "logo_5"]
    }
  ]
}
{% endschema %}
