    }
  ],
  "presets": [
    {
      "name": "t:names.logo_list",
      "category": "t:categories.storytelling",
      "blocks": {
        "logo_1": {
          "type": "_logo"
        },
        "logo_2": {
          "type": "_logo"
        },
        "logo_3": {
          "type": "_logo"
        },
        "logo_4": {
          "type": "_logo"
        },
        "logo_5": {
          "type": "_logo"
        }
      },
      "block_order": [
        "logo_1",
        "logo_2",
        "logo_3",
        "logo_4",
        "logo_5"
      ]
    }
  ]
}
{% endschema %}
