{% comment %}
  Brand story, split in two: a centered headline, two photos, and a short
  story with a link on one side; a tall photo on the other.
{% endcomment %}

<div class="brand-story brand-story--image-{{ section.settings.image_position }}">
  <div class="brand-story__story">
    {% if section.settings.heading != blank %}
      <h2 class="h1">{{ section.settings.heading | escape | newline_to_br }}</h2>
    {% endif %}

    <div class="brand-story__photos">
      {% for i in (1..2) %}
        {%- liquid
          if i == 1
            assign photo = section.settings.photo_1
          else
            assign photo = section.settings.photo_2
          endif
        -%}
        <div class="brand-story__photo">
          {% if photo != blank %}
            {{ photo | image_url: width: 800 | image_tag: widths: '300, 532, 800', sizes: '(min-width: 990px) 266px, 45vw', loading: 'lazy', alt: photo.alt }}
          {% else %}
            {% render 'placeholder', name: 'image' %}
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="brand-story__copy">
      {% if section.settings.text != blank %}
        <div class="body-l">{{ section.settings.text }}</div>
      {% endif %}
      {% if section.settings.link_label != blank %}
        <a class="brand-story__link" href="{{ section.settings.link | default: routes.root_url }}">
          {{- section.settings.link_label | escape -}}
        </a>
      {% endif %}
    </div>
  </div>

  <div class="brand-story__image">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: widths: '600, 900, 1200, 1800', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: section.settings.image.alt }}
    {% else %}
      {% render 'placeholder', name: 'lifestyle-1' %}
    {% endif %}
  </div>
</div>

