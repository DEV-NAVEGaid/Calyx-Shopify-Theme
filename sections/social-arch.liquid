{% comment %}
  Social arch ("Follow us"): a big heading and the account handle, over a
  row of photo cards (blocks) stepped like an arch, the middle card the
  tallest. The arch turns one card at a time on a timer, pausing on hover
  (assets/social-arch.js).
{% endcomment %}

<social-arch class="home-section social-arch spacing-style" data-autoplay="{{ section.settings.autoplay }}" style="{% render 'spacing-style', settings: section.settings %}">
  <div class="home-section__inner">
    <div class="social-arch__header">
      {% if section.settings.heading != blank %}
        <h2 class="social-arch__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}
      {% if section.settings.handle != blank %}
        <a class="social-arch__handle" href="{{ section.settings.link | default: settings.social_instagram_link }}">{{ section.settings.handle | escape }}</a>
      {% endif %}
    </div>
    <ul class="social-arch__cards" role="list">
      {% content_for 'blocks' %}
    </ul>
  </div>
</social-arch>

<script src="{{ 'social-arch.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:names.social_arch",
  "class": "section-wrapper",
  "tag": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [{ "type": "_social-card" }],
  "max_blocks": 11,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "t:text_defaults.follow_us"
    },
    {
      "type": "text",
      "id": "handle",
      "label": "t:settings.handle",
      "default": "@yourcommunity"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "t:info.social_handle_link"
    },
    {
      "type": "range",
      "id": "autoplay",
      "label": "t:settings.autoplay_speed",
      "info": "t:info.autoplay_off",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "s",
      "default": 4
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "t:names.social_arch",
      "category": "t:categories.storytelling",
      "blocks": {
        "card_1": { "type": "_social-card", "settings": { "title": "Slow Sundays", "handle": "@maya.morning" } },
        "card_2": { "type": "_social-card", "settings": { "title": "Golden Hour Walks", "handle": "@daniel.k" } },
        "card_3": { "type": "_social-card", "settings": { "title": "Desk Ritual", "handle": "@priya.s" } },
        "card_4": { "type": "_social-card", "settings": { "title": "Night Orchid Hours", "handle": "@yourcommunity" } },
        "card_5": { "type": "_social-card", "settings": { "title": "Fig Leaf Mornings", "handle": "@helen.cph" } },
        "card_6": { "type": "_social-card", "settings": { "title": "Breathe. Spray. Say.", "handle": "@lena.k" } },
        "card_7": { "type": "_social-card", "settings": { "title": "Quiet Evenings", "handle": "@sam.r" } }
      },
      "block_order": ["card_1", "card_2", "card_3", "card_4", "card_5", "card_6", "card_7"]
    }
  ]
}
{% endschema %}
